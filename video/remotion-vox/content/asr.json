 "segs": [
  {
   "i": 0,
   "start": 0.0,
   "end": 2.971,
   "text": "تخيل أنك تغيرين غطاء وسادة"
  },
  {
   "i": 1,
   "start": 2.971,
   "end": 5.912,
   "text": "وتلمس يدكي شيء أنصلبا في داخلها"
  },
  {
   "i": 2,
   "start": 5.912,
   "end": 7.09,
   "text": "تفتحينه"
  },
  {
   "i": 3,
   "start": 7.09,
   "end": 10.367,
   "text": "فتجدين خيوطا معقودة وشعرات"
  },
  {
   "i": 4,
   "start": 10.367,
   "end": 13.989,
   "text": "وورقة مطوية عليها كتابة لا تقرأ"
  },
  {
   "i": 5,
   "start": 13.989,
   "end": 15.681,
   "text": "يرتجف قلبك"
  },
  {
   "i": 6,
   "start": 15.681,
   "end": 17.792,
   "text": "وتذكرين الأشهر الماضية"
  },
  {
   "i": 7,
   "start": 17.792,
   "end": 22.937,
   "text": "خلافات بلا سبب وأرق وقلب لم يرتاح في هذا البيت"
  },
  {
   "i": 8,
   "start": 22.937,
   "end": 25.657,
   "text": "وأول سؤال يقفز إلى ذهنك"
  },
  {
   "i": 9,
   "start": 25.657,
   "end": 27.482,
   "text": "من فعل هذا؟"
  },
  {
   "i": 10,
   "start": 27.482,
   "end": 28.508,
   "text": "مالن"
  },
  {
   "i": 11,
   "start": 28.508,
   "end": 29.686,
   "text": "قبل أن تجيب"
  },
  {
   "i": 12,
   "start": 29.686,
   "end": 33.071,
   "text": "تعالي نرى ماذا يقول الكتاب والسنة عن السحر"
  },
  {
   "i": 13,
   "start": 33.071,
   "end": 35.47,
   "text": "وما العلامات التي يذكرها الرقاة"
  },
  {
   "i": 14,
   "start": 35.47,
   "end": 37.127,
   "text": "ولماذا لا يقطع بها؟"
  },
  {
   "i": 15,
   "start": 37.127,
   "end": 41.028,
   "text": "وماذا تفعلين ان وجدت شيئا كهذا؟ والأهم من ذلك"
  },
  {
   "i": 16,
   "start": 41.028,
   "end": 43.311,
   "text": "مال الذي يجب أن لا تفعله؟"
  },
  {
   "i": 17,
   "start": 43.311,
   "end": 44.834,
   "text": "السحر حقيقة"
  },
  {
   "i": 18,
   "start": 44.834,
   "end": 47.165,
   "text": "لكنه بلا قوة مستقلة"
  },
  {
   "i": 19,
   "start": 47.165,
   "end": 49.732,
   "text": "قال تعالى عن الذين يتعلمون السحر"
  },
  {
   "i": 20,
   "start": 49.732,
   "end": 54.341,
   "text": "فيتعلمون منهما ما يفرقون به بين المرء وزوجه"
  },
  {
   "i": 21,
   "start": 54.341,
   "end": 55.886,
   "text": "ثم قال مباشرة"
  },
  {
   "i": 22,
   "start": 55.886,
   "end": 60.319,
   "text": "وما هم بضارين به من أحد إلا بإذن الله"
  },
  {
   "i": 23,
   "start": 60.319,
   "end": 62.554,
   "text": "احفظ هاتين الجملةين معا"
  },
  {
   "i": 24,
   "start": 62.554,
   "end": 68.95,
   "text": "السحر موجود لكن الساحر ليس إلها ولا تعمن عقدة ولا تلصم إلا بإذ الله"
  },
  {
   "i": 25,
   "start": 68.95,
   "end": 70.193,
   "text": "وقال سبحانه"
  },
  {
   "i": 26,
   "start": 70.193,
   "end": 72.955,
   "text": "ولا يفلح الساحر حيث أتا"
  },
  {
   "i": 27,
   "start": 72.955,
   "end": 75.104,
   "text": "علمات يذكرها الرقا"
  },
  {
   "i": 28,
   "start": 75.104,
   "end": 79.222,
   "text": "يذكل أهل الخبرات علامات قد تظهر في بيت أصابه الس"
  },
  {
   "i": 29,
   "start": 79.222,
   "end": 85.304,
   "text": "نفور وشجار مفاجئ بين الزوجين وخصوصا إذا كان على وفاق خارج البيت"
  },
  {
   "i": 30,
   "start": 85.304,
   "end": 87.722,
   "text": "فإذا دخلها بدأت توتر"
  },
  {
   "i": 31,
   "start": 87.722,
   "end": 93.106,
   "text": "ثقل وضيق في الصدري عند دخول البيت وانشراح عند الخروج منه"
  },
  {
   "i": 32,
   "start": 93.106,
   "end": 97.043,
   "text": "كوبيس متكرر عند أكثر من فرد من أهل البيت"
  },
  {
   "i": 33,
   "start": 97.043,
   "end": 101.358,
   "text": "ثقل غريب وفتور عن الصلاة والقرآن داخل البيت"
  },
  {
   "i": 34,
   "start": 101.358,
   "end": 103.277,
   "text": "وظهر أشياء غريبة"
  },
  {
   "i": 35,
   "start": 103.277,
   "end": 104.905,
   "text": "عقد والشعر"
  },
  {
   "i": 36,
   "start": 104.905,
   "end": 108.095,
   "text": "وأوراق برموز وكتابات غير مفهومة"
  },
  {
   "i": 37,
   "start": 108.095,
   "end": 111.105,
   "text": "أو أغراض لا يعرف أحد من أين جأت"
  },
  {
   "i": 38,
   "start": 111.105,
   "end": 113.907,
   "text": "وهنا أهم ما في هذه الحلقة"
  },
  {
   "i": 39,
   "start": 113.907,
   "end": 118.524,
   "text": "لا شيء من هذه العلمات وحده دليل قاطع على السهر"
  },
  {
   "i": 40,
   "start": 118.524,
   "end": 120.2,
   "text": "فشجار بين الزوجين"
  },
  {
   "i": 41,
   "start": 120.2,
   "end": 121.893,
   "text": "قد يكون من حدة اللسان"
  },
  {
   "i": 42,
   "start": 121.893,
   "end": 124.557,
   "text": "أو كثرة المطالب أو ضيق الحال"
  },
  {
   "i": 43,
   "start": 124.557,
   "end": 125.657,
   "text": "أو التعب"
  },
  {
   "i": 44,
   "start": 125.657,
   "end": 127.303,
   "text": "والفتور عن العبادة"
  },
  {
   "i": 45,
   "start": 127.303,
   "end": 129.392,
   "text": "قد يكون من الذنوب والغفلة"
  },
  {
   "i": 46,
   "start": 129.392,
   "end": 133.642,
   "text": "ولكثير من هذه الأحوال أسباب طبيعية واضحة"
  },
  {
   "i": 47,
   "start": 133.642,
   "end": 134.716,
   "text": "قال تعالى"
  },
  {
   "i": 48,
   "start": 134.716,
   "end": 139.944,
   "text": "وما أصابكم من مصيبة فبما كسبت أيديكم ويعفوا عن كثير"
  },
  {
   "i": 49,
   "start": 139.944,
   "end": 143.864,
   "text": "وأخطر ما في الأمر أن نعلق كل مشكلة على السحر"
  },
  {
   "i": 50,
   "start": 143.864,
   "end": 146.324,
   "text": "ونعفي أنفسنا من المسؤولية"
  },
  {
   "i": 51,
   "start": 146.324,
   "end": 149.032,
   "text": "فإن كان البيت خاليا من الصلاة والذكر"
  },
  {
   "i": 52,
   "start": 149.032,
   "end": 151.024,
   "text": "وألسنة أهله حاد"
  },
  {
   "i": 53,
   "start": 151.024,
   "end": 153.16,
   "text": "فهذا أول ما يصلح"
  },
  {
   "i": 54,
   "start": 153.16,
   "end": 158.287,
   "text": "والبشر أن علاج السحر وعلاج هذه المشكلات طريق واحد"
  },
  {
   "i": 55,
   "start": 158.287,
   "end": 159.998,
   "text": "الرجوع إلى الله"
  },
  {
   "i": 56,
   "start": 159.998,
   "end": 162.224,
   "text": "ولا تسألي من فعل"
  },
  {
   "i": 57,
   "start": 162.224,
   "end": 166.94,
   "text": "في صحيح البخاري أن نبي صلى الله عليه وسلم نفسه سحر"
  },
  {
   "i": 58,
   "start": 166.94,
   "end": 170.043,
   "text": "سحره رجل يقال له لبيد بن الأعصم"
  },
  {
   "i": 59,
   "start": 170.043,
   "end": 172.842,
   "text": "في مصط وشعر أخفاه في بير"
  },
  {
   "i": 60,
   "start": 172.842,
   "end": 175.783,
   "text": "فأطلعه الله عليه وعافا"
  },
  {
   "i": 61,
   "start": 175.783,
   "end": 178.166,
   "text": "فقالت عائشة رضي الله عنها"
  },
  {
   "i": 62,
   "start": 178.166,
   "end": 181.37,
   "text": "يا رسول الله أفل استخرجته وأظهرته؟"
  },
  {
   "i": 63,
   "start": 181.37,
   "end": 183.903,
   "text": "فقال قد عافان الله"
  },
  {
   "i": 64,
   "start": 183.903,
   "end": 186.85,
   "text": "فكرت أن أثير على الناس فيه شراء"
  },
  {
   "i": 65,
   "start": 186.85,
   "end": 189.349,
   "text": "وامر بالبئري فدفنت"
  },
  {
   "i": 66,
   "start": 189.349,
   "end": 190.303,
   "text": "تأملي"
  },
  {
   "i": 67,
   "start": 190.303,
   "end": 194.548,
   "text": "النبي صلى الله عليه وسلم يعرف الساحرة بعينة"
  },
  {
   "i": 68,
   "start": 194.548,
   "end": 198.5,
   "text": "ومع ذلك لم يشأ أن يثير فتنة بين الناس"
  },
  {
   "i": 69,
   "start": 198.5,
   "end": 203.51,
   "text": "فكيف نقاطع نحن أخت الزوج أو أمه أو جارا أو قريبا؟"
  },
  {
   "i": 70,
   "start": 203.51,
   "end": 204.91,
   "text": "لمجرد ديغان"
  },
  {
   "i": 71,
   "start": 204.91,
   "end": 206.252,
   "text": "قال تعالى"
  },
  {
   "i": 72,
   "start": 206.252,
   "end": 210.279,
   "text": "يا أيها الذين آمن جتنب كثيرا من الظن"
  },
  {
   "i": 73,
   "start": 210.279,
   "end": 212.448,
   "text": "إن بعض الظن إسمة"
  },
  {
   "i": 74,
   "start": 212.448,
   "end": 212.921,
   "text": "(تروني"
  },
  {
   "i": 75,
   "start": 212.921,
   "end": 213.685,
   "text": "وعلمي"
  },
  {
   "i": 76,
   "start": 213.685,
   "end": 216.529,
   "text": "أن من أكبر حيل الدجالين قولهم"
  },
  {
   "i": 77,
   "start": 216.529,
   "end": 219.146,
   "text": "أحد أقاربك فعل بك هذا"
  },
  {
   "i": 78,
   "start": 219.146,
   "end": 222.491,
   "text": "بياذه الجملة وحدها تتفكك العائلات"
  },
  {
   "i": 79,
   "start": 222.491,
   "end": 226.407,
   "text": "ويصنع الدجال سحراً أكبر من كل تلك العقد"
  },
  {
   "i": 80,
   "start": 226.407,
   "end": 226.92,
   "text": "(تصميم"
  },
  {
   "i": 81,
   "start": 226.92,
   "end": 229.326,
   "text": "فإن وجدت شيئاً فماذا تف"
  },
  {
   "i": 82,
   "start": 229.326,
   "end": 230.166,
   "text": "أولاً"
  },
  {
   "i": 83,
   "start": 230.166,
   "end": 231.295,
   "text": "لا تحافي"
  },
  {
   "i": 84,
   "start": 231.295,
   "end": 235.721,
   "text": "فتلك الورقة وذلك الخيط لا قوة لهم إلا بإذن الله"
  },
  {
   "i": 85,
   "start": 235.721,
   "end": 239.804,
   "text": "ثانياً، إقرأ عليه الفلق والناس وأية الكرسي"
  },
  {
   "i": 86,
   "start": 239.804,
   "end": 242.276,
   "text": "فقد علمنا الله أن نستعيذ به"
  },
  {
   "i": 87,
   "start": 242.276,
   "end": 244.95,
   "text": "ومن شر النفاثات في العقد"
  },
  {
   "i": 88,
   "start": 244.95,
   "end": 249.158,
   "text": "ثالثا إقرأي آيات إبطال السحر كقوله تعالى"
  },
  {
   "i": 89,
   "start": 249.158,
   "end": 252.506,
   "text": "ما جئتم به السحر إن الله سيبطله"
  },
  {
   "i": 90,
   "start": 252.506,
   "end": 255.577,
   "text": "إن الله لا يصلح عمل المفسدين"
  },
  {
   "i": 91,
   "start": 255.577,
   "end": 256.661,
   "text": "رابعا"
  },
  {
   "i": 92,
   "start": 256.661,
   "end": 260.082,
   "text": "حل العقد وضعه في الماء حتى تذوب الكتابة"
  },
  {
   "i": 93,
   "start": 260.082,
   "end": 265.941,
   "text": "ثم تخلص من أو تفينيه كما أمر النبي صلى الله عليه وسلم بالبئر فدفنات"
  },
  {
   "i": 94,
   "start": 265.941,
   "end": 266.992,
   "text": "خمسا"
  },
  {
   "i": 95,
   "start": 266.992,
   "end": 270.204,
   "text": "لا تريه لمن يصنع منه حكاية وفتنة"
  },
  {
   "i": 96,
   "start": 270.204,
   "end": 272.312,
   "text": "ولا تفكي السحر بالسحر"
  },
  {
   "i": 97,
   "start": 272.312,
   "end": 277.327,
   "text": "بعض الناس إذا وجد شيئاً كهذا ذهب إلى من يدعي ابطال السعر"
  },
  {
   "i": 98,
   "start": 277.327,
   "end": 282.034,
   "text": "وقد سوى إلى نبي صلى الله عليه وسلم عن النشرة وهي حل السحر بسحر مث"
  },
  {
   "i": 99,
   "start": 282.034,
   "end": 284.007,
   "text": "فقال هي من عمل الشيطان"
  },
  {
   "i": 100,
   "start": 284.007,
   "end": 289.473,
   "text": "وقال من أتعرافا فسأله عن شيء لم تقبل له صلاة 40 ليلة"
  },
  {
   "i": 101,
   "start": 289.473,
   "end": 299.629,
   "text": "فإن طلب منك أحد اسم أمك أو ذبيحة بصيفة معينة أو عطاك طلسما وكتابة مبهمة أو طلب مالا طائلا فعلمي أنه من أهل"
  },
  {
   "i": 102,
   "start": 299.629,
   "end": 302.637,
   "text": "وأما تحصين البيت وعلاجه بالطريقة الشر"
  },
  {
   "i": 103,
   "start": 302.637,
   "end": 307.457,
   "text": "أولا سورة البقرة قال صلى الله عليه وسلم اقرأوا سورة البقرة"
  },
  {
   "i": 104,
   "start": 307.457,
   "end": 316.296,
   "text": "فإن أخذها بركة وتركها حسرة ولا يستطيعها البطلة والبطلة هم السحرة وأخبر أن الشيطان ينفر من البيت الذي تقرأ"
  },
  {
   "i": 105,
   "start": 316.296,
   "end": 336.308,
   "text": "فقرأيها في بيتك ولو على أيام أو تقاسموها بين أهل البيت ثانيا أذكار الصباح والمساء آية الكرسي وخواتيم البقرة والإخلاص والفلق والناس ثلاثا ومعها هذا ذكر مئة مرة في اليوم فهو حرز من الشيطان حتى يمسي لا إله إلا الله وحده لا شريك له له الم"
  },
  {
   "i": 106,
   "start": 336.308,
   "end": 337.856,
   "text": "وهو على كل شيء قدير"
  },
  {
   "i": 107,
   "start": 337.856,
   "end": 344.417,
   "text": "ثالثا ماء الرقية اقرأ الفاتحة وآية الكرسي والمعوذات وآيات ابطال السح"
  },
  {
   "i": 108,
   "start": 344.417,
   "end": 345.361,
   "text": "1/4"
  },
  {
   "i": 109,
   "start": 345.361,
   "end": 347.848,
   "text": "فيشرب منه أهل البيت ويغتس"
  },
  {
   "i": 110,
   "start": 347.848,
   "end": 350.456,
   "text": "وقد أجاز ذلك كثير من أهل العلم"
  },
  {
   "i": 111,
   "start": 350.456,
   "end": 351.353,
   "text": "رابعا"
  },
  {
   "i": 112,
   "start": 351.353,
   "end": 352.587,
   "text": "تمر العجوة"
  },
  {
   "i": 113,
   "start": 352.587,
   "end": 354.437,
   "text": "قال صلى الله عليه وسلم"
  },
  {
   "i": 114,
   "start": 354.437,
   "end": 357.638,
   "text": "من تصبح كل يوم 7 مرات عجوة"
  },
  {
   "i": 115,
   "start": 357.638,
   "end": 361.029,
   "text": "لم يضره في ذلك اليوم سم ولا سحر"
  },
  {
   "i": 116,
   "start": 361.029,
   "end": 361.983,
   "text": "خمسن"
  },
  {
   "i": 117,
   "start": 361.983,
   "end": 365.137,
   "text": "الصلاة في البيت قال صلى الله عليه وسلم"
  },
  {
   "i": 118,
   "start": 365.137,
   "end": 369.065,
   "text": "اجعل في بيوتكم من صلاتكم ولا تتخذوها قبوراً"
  },
  {
   "i": 119,
   "start": 369.065,
   "end": 373.207,
   "text": "والبيت الذي يسجد فيه لله لا يطيب فيه مقام للشيطان"
  },
  {
   "i": 120,
   "start": 373.207,
   "end": 375.749,
   "text": "سادساً الصبر واليقين"
  },
  {
   "i": 121,
   "start": 375.749,
   "end": 377.459,
   "text": "فالإلاج لا يتم في يوم"
  },
  {
   "i": 122,
   "start": 377.459,
   "end": 378.748,
   "text": "وتذكر دائماً"
  },
  {
   "i": 123,
   "start": 378.748,
   "end": 380.609,
   "text": "إن الله سيبتله"
  },
  {
   "i": 124,
   "start": 380.609,
   "end": 382.285,
   "text": "احفظ هذه الكلمات"
  },
  {
   "i": 125,
   "start": 382.285,
   "end": 383.433,
   "text": "السحر حق"
  },
  {
   "i": 126,
   "start": 383.433,
   "end": 385.85,
   "text": "لكنه لا يضر إلا بإذن الله"
  },
  {
   "i": 127,
   "start": 385.85,
   "end": 390.146,
   "text": "ليست كل علامة سحرا ولا تعلق كل مشكلة عليه"
  },
  {
   "i": 128,
   "start": 390.146,
   "end": 392.197,
   "text": "لا تتهمي أحدا بالظن"
  },
  {
   "i": 129,
   "start": 392.197,
   "end": 396.053,
   "text": "فالنبي صلى الله عليه وسلم لم يفضح حتى ساحرة"
  },
  {
   "i": 130,
   "start": 396.053,
   "end": 398.09,
   "text": "لا تفكي السحر بالسحر"
  },
  {
   "i": 131,
   "start": 398.09,
   "end": 401.236,
   "text": "وحصني بيتكيب القرآن والذكر وصل"
  },
  {
   "i": 132,
   "start": 401.236,
   "end": 405.101,
   "text": "أرسلي هذا المقطع لكل أسرة تعيش في الخوف وسوء الظن"
  },
  {
   "i": 133,
   "start": 405.101,
   "end": 406.635,
   "text": "وكتم في التعليقات"
  },
  {
   "i": 134,
   "start": 406.635,
   "end": 408.894,
   "text": "اللهم عمر بيوتنا بالقرآن"
  },
  {
   "i": 135,
   "start": 408.894,
   "end": 410.876,
   "text": "واملأها سكينة ورحمة"
  },
  {
   "i": 136,
   "start": 410.876,
   "end": 411.88,
   "text": "أمين"
  }
 ]
}