 "segs": [
  {
   "i": 0,
   "start": 0.0,
   "end": 0.129,
   "text": "[موس"
  },
  {
   "i": 1,
   "start": 0.129,
   "end": 2.462,
   "text": "أظنوا أن أحدا عمل لي سحرا"
  },
  {
   "i": 2,
   "start": 2.462,
   "end": 4.524,
   "text": "عبارة نسمعها كثيرا"
  },
  {
   "i": 3,
   "start": 4.524,
   "end": 7.59,
   "text": "من زوجة بردام بينها وبين زوجها فجأة"
  },
  {
   "i": 4,
   "start": 7.59,
   "end": 11.3,
   "text": "ومن فتاة يأتي الخطاب ثم ينصرفون واحد بعد واحد"
  },
  {
   "i": 5,
   "start": 11.3,
   "end": 15.64,
   "text": "ومن شاب كأن عمله ودرسته وحياته كلها قد عقدت"
  },
  {
   "i": 6,
   "start": 15.64,
   "end": 16.342,
   "text": "لكن"
  },
  {
   "i": 7,
   "start": 16.342,
   "end": 17.529,
   "text": "السؤال الحقيقي"
  },
  {
   "i": 8,
   "start": 17.529,
   "end": 19.026,
   "text": "كيف نعرف فعلا؟"
  },
  {
   "i": 9,
   "start": 19.026,
   "end": 21.099,
   "text": "هل كل عقدة في الحياة السحر؟"
  },
  {
   "i": 10,
   "start": 21.099,
   "end": 23.501,
   "text": "ولماذا يذهب بعض الناس ليعرف الج"
  },
  {
   "i": 11,
   "start": 23.501,
   "end": 25.544,
   "text": "إلى من يكتبون السحر أنفسهم"
  },
  {
   "i": 12,
   "start": 25.544,
   "end": 27.296,
   "text": "نجيب اليوم عن هذا السؤال"
  },
  {
   "i": 13,
   "start": 27.296,
   "end": 30.642,
   "text": "من القرآن والسنة وكتب أهل العلم بالرقية"
  },
  {
   "i": 14,
   "start": 30.642,
   "end": 31.835,
   "text": "قبل كل شيء"
  },
  {
   "i": 15,
   "start": 31.835,
   "end": 33.617,
   "text": "لا يعلم الغيبة إلا الله"
  },
  {
   "i": 16,
   "start": 33.617,
   "end": 38.0,
   "text": "لا يصطيع إنسان أن يقول لك جازما أنت مسحور وفلان فعلها"
  },
  {
   "i": 17,
   "start": 38.0,
   "end": 40.112,
   "text": "والسحر مدفون في المكان الفلاني"
  },
  {
   "i": 18,
   "start": 40.112,
   "end": 41.149,
   "text": "قال تعالى"
  },
  {
   "i": 19,
   "start": 41.149,
   "end": 44.679,
   "text": "قل لا يعلم من في السماوات والأرض الغيب إلا الله"
  },
  {
   "i": 20,
   "start": 44.679,
   "end": 46.047,
   "text": "فمن يدعى ذلك"
  },
  {
   "i": 21,
   "start": 46.047,
   "end": 49.887,
   "text": "فإما أنه يختلق وإما أنه يتلقى من الجن والكو"
  },
  {
   "i": 22,
   "start": 49.887,
   "end": 51.642,
   "text": "وقار صلى الله عليه وسلم"
  },
  {
   "i": 23,
   "start": 51.642,
   "end": 54.899,
   "text": "من أتا كاهن أو عرافا فصدقه بما يقول"
  },
  {
   "i": 24,
   "start": 54.899,
   "end": 57.517,
   "text": "فقد كفر بما انزل على محمد"
  },
  {
   "i": 25,
   "start": 57.517,
   "end": 60.66,
   "text": "فما يذكره الروقاء على مات يستانس بها"
  },
  {
   "i": 26,
   "start": 60.66,
   "end": 62.634,
   "text": "لا يقين يبنى عليه"
  },
  {
   "i": 27,
   "start": 62.634,
   "end": 64.993,
   "text": "العلامات بحسب نوع السحر"
  },
  {
   "i": 28,
   "start": 64.993,
   "end": 68.091,
   "text": "قصم أن العلم بالرقية السحر بحسب غايته"
  },
  {
   "i": 29,
   "start": 68.091,
   "end": 70.248,
   "text": "وذكر لكل نوع علامته"
  },
  {
   "i": 30,
   "start": 70.248,
   "end": 71.454,
   "text": "النور الأول"
  },
  {
   "i": 31,
   "start": 71.454,
   "end": 72.718,
   "text": "سحر التفريق"
  },
  {
   "i": 32,
   "start": 72.718,
   "end": 74.204,
   "text": "وهو الذي قال الله فيه"
  },
  {
   "i": 33,
   "start": 74.204,
   "end": 76.847,
   "text": "ما يفرقون به بين المرء وزوجه"
  },
  {
   "i": 34,
   "start": 76.847,
   "end": 78.293,
   "text": "ومن علاماته"
  },
  {
   "i": 35,
   "start": 78.293,
   "end": 81.288,
   "text": "انقلاب المحبة إلى بغض فجأة"
  },
  {
   "i": 36,
   "start": 81.288,
   "end": 86.453,
   "text": "دون حادث يذكر وتضخم الصغائر حتى يصير الخلاف على لا شيء"
  },
  {
   "i": 37,
   "start": 86.453,
   "end": 90.96,
   "text": "وكثرة الشكوك وأن يرى أحد الزوجين صاحبه قبيح الصورة"
  },
  {
   "i": 38,
   "start": 90.96,
   "end": 96.412,
   "text": "أو ينفر من المكان الذي يجليس فيه مع أنه خارج البيت على حاله المعتاد"
  },
  {
   "i": 39,
   "start": 96.412,
   "end": 97.645,
   "text": "النوع الثاني"
  },
  {
   "i": 40,
   "start": 97.645,
   "end": 99.464,
   "text": "سحر تعطيل الزواج"
  },
  {
   "i": 41,
   "start": 99.464,
   "end": 101.404,
   "text": "يأت الخاطم ويرضى"
  },
  {
   "i": 42,
   "start": 101.404,
   "end": 103.36,
   "text": "ثم يعدل فجأة بلاسبب"
  },
  {
   "i": 43,
   "start": 103.36,
   "end": 105.706,
   "text": "ويتكرر ذلك مرة بعد مرة"
  },
  {
   "i": 44,
   "start": 105.706,
   "end": 108.144,
   "text": "أو يضيق صدر الفتاة أو الشاب"
  },
  {
   "i": 45,
   "start": 108.144,
   "end": 111.207,
   "text": "كلما ذكر الزواج، فيرفض بلا سبب"
  },
  {
   "i": 46,
   "start": 111.207,
   "end": 112.605,
   "text": "أنه وثالث"
  },
  {
   "i": 47,
   "start": 112.605,
   "end": 114.213,
   "text": "سحر الخمول"
  },
  {
   "i": 48,
   "start": 114.213,
   "end": 116.218,
   "text": "حب العزلة والصمط"
  },
  {
   "i": 49,
   "start": 116.218,
   "end": 119.971,
   "text": "وكثرة نوم والفتور الدائم وتشتت الذهن"
  },
  {
   "i": 50,
   "start": 119.971,
   "end": 124.142,
   "text": "وترك عمل أو دراسة كان صاحبها شغوفا بهمة"
  },
  {
   "i": 51,
   "start": 124.142,
   "end": 126.876,
   "text": "أنه الرابع سحر المحبة"
  },
  {
   "i": 52,
   "start": 126.876,
   "end": 130.185,
   "text": "لا يرد به التفريق بل استمالة قلب ما"
  },
  {
   "i": 53,
   "start": 130.185,
   "end": 137.885,
   "text": "وعلمته محبة مفرطة مفاجئة لا يقبلها العقل وقلق شديد عند البعد وطاعة عمياء"
  },
  {
   "i": 54,
   "start": 137.885,
   "end": 140.952,
   "text": "النوع الخامس، سحر التخيل"
  },
  {
   "i": 55,
   "start": 140.952,
   "end": 142.928,
   "text": "قال تعالى في سحرة فرعون"
  },
  {
   "i": 56,
   "start": 142.928,
   "end": 146.193,
   "text": "يخيل إليه من سحرهم أنها تسعة"
  },
  {
   "i": 57,
   "start": 146.193,
   "end": 146.574,
   "text": "تقريب"
  },
  {
   "i": 58,
   "start": 146.574,
   "end": 148.99,
   "text": "فيرى المسحور شيء على غير حقيقت"
  },
  {
   "i": 59,
   "start": 148.99,
   "end": 152.027,
   "text": "الساكنة متحركة والصغيرة كبيرة"
  },
  {
   "i": 60,
   "start": 152.027,
   "end": 154.084,
   "text": "وعلمات العم"
  },
  {
   "i": 61,
   "start": 154.084,
   "end": 158.142,
   "text": "ويذكر الرقاط علامات مشتركة بين أكثر الأنواع"
  },
  {
   "i": 62,
   "start": 158.142,
   "end": 165.293,
   "text": "كوابيس متكررة وبخاصة رؤية حيوانات مخيفة أو السقط من مكان عالٍ أو من يطارد النائم؟"
  },
  {
   "i": 63,
   "start": 165.293,
   "end": 165.655,
   "text": "(تصم"
  },
  {
   "i": 64,
   "start": 165.655,
   "end": 169.333,
   "text": "وضيقا وثقلا في الصدر عند الأذان أو سماع القر"
  },
  {
   "i": 65,
   "start": 169.333,
   "end": 172.481,
   "text": "ونفور شديدا مفاجئا من الصلاة والذكر"
  },
  {
   "i": 66,
   "start": 172.481,
   "end": 175.756,
   "text": "والعثور على أشياء غريبة في البيت أو بين الأغراض"
  },
  {
   "i": 67,
   "start": 175.756,
   "end": 178.596,
   "text": "عؤد وشعر وأورق مكتوبة"
  },
  {
   "i": 68,
   "start": 178.596,
   "end": 180.838,
   "text": "لكنها ليست قاطعة"
  },
  {
   "i": 69,
   "start": 180.838,
   "end": 184.626,
   "text": "كل علامة من هذه يمكن أن يكون لها سبغ أخر"
  },
  {
   "i": 70,
   "start": 184.626,
   "end": 188.482,
   "text": "فالخلاف الزوجي قد يكون من حدة اللسان وكثرة المط"
  },
  {
   "i": 71,
   "start": 188.482,
   "end": 194.089,
   "text": "وطعصر الأمور قد يكون ابتلاء من الله والثقل في العبادة قد يكون من الذنوب وال"
  },
  {
   "i": 72,
   "start": 194.089,
   "end": 195.331,
   "text": "قالت على"
  },
  {
   "i": 73,
   "start": 195.331,
   "end": 201.251,
   "text": "وما أصابكم من مصيبة فبما كسبت أيديكم ويعفوا عن كثير"
  },
  {
   "i": 74,
   "start": 201.251,
   "end": 205.029,
   "text": "وأسوأ ما نفعله أن نتهم قريبا أو جارا بضن"
  },
  {
   "i": 75,
   "start": 205.029,
   "end": 207.558,
   "text": "لقد صحر النبي صلى الله عليه وسلم"
  },
  {
   "i": 76,
   "start": 207.558,
   "end": 209.279,
   "text": "وكان يعرف ساحرة"
  },
  {
   "i": 77,
   "start": 209.279,
   "end": 210.077,
   "text": "فقال"
  },
  {
   "i": 78,
   "start": 210.077,
   "end": 213.191,
   "text": "فكرهت أن أثير على الناس فيه شراء"
  },
  {
   "i": 79,
   "start": 213.191,
   "end": 214.783,
   "text": "كيف تعرف السحر؟"
  },
  {
   "i": 80,
   "start": 214.783,
   "end": 216.714,
   "text": "وهذا أمر يجهله كثيرون"
  },
  {
   "i": 81,
   "start": 216.714,
   "end": 219.565,
   "text": "أحيانا يكون الذي نذهب إليه لفك السح"
  },
  {
   "i": 82,
   "start": 219.565,
   "end": 220.846,
   "text": "هو السحر نفسه"
  },
  {
   "i": 83,
   "start": 220.846,
   "end": 224.209,
   "text": "وقد ذكر أهل العلم بالرقيا على ما تنتكشفه"
  },
  {
   "i": 84,
   "start": 224.209,
   "end": 226.476,
   "text": "يسألك عن اسمك واسم أمك"
  },
  {
   "i": 85,
   "start": 226.476,
   "end": 229.62,
   "text": "يطلب شيء من ثيابك أو شعرك أو أصفارك"
  },
  {
   "i": 86,
   "start": 229.62,
   "end": 232.404,
   "text": "يطلح حيوانا بلون أو صفة معينة"
  },
  {
   "i": 87,
   "start": 232.404,
   "end": 238.009,
   "text": "ليذبحه وربما لا يذكر اسم الله عليه وربما أمرك أن تلطخ بدمه شيئاً"
  },
  {
   "i": 88,
   "start": 238.009,
   "end": 240.652,
   "text": "يتم تيموا بكريمات غير مفهومة"
  },
  {
   "i": 89,
   "start": 240.652,
   "end": 246.216,
   "text": "يعتيك ورقة فيها جداول وارقام وحروف مقطعة ويأمرك أن تعليقها"
  },
  {
   "i": 90,
   "start": 246.216,
   "end": 251.394,
   "text": "يا مرك انت اعتازل الناس اياما في غرفة مظمة او ان لا تمس الماء مدة"
  },
  {
   "i": 91,
   "start": 251.394,
   "end": 253.18,
   "text": "يُعطيك شيئًا تدف"
  },
  {
   "i": 92,
   "start": 253.18,
   "end": 256.196,
   "text": "الورقة تنطح رقها وتتبخر بدخانها"
  },
  {
   "i": 93,
   "start": 256.196,
   "end": 260.495,
   "text": "وقد يخبرك بسمك وبلدك ومشكلتك قبل أن تتكلم"
  },
  {
   "i": 94,
   "start": 260.495,
   "end": 261.41,
   "text": "ليبهرك"
  },
  {
   "i": 95,
   "start": 261.41,
   "end": 266.245,
   "text": "فإن رأيت شيئاً من ذلك فعلم أنك في المكان الخطأ فقم ونصرف"
  },
  {
   "i": 96,
   "start": 266.245,
   "end": 270.504,
   "text": "قال صلى الله عليه وسلم من علق تميمة فقد أشرك"
  },
  {
   "i": 97,
   "start": 270.504,
   "end": 272.495,
   "text": "وقال عن حل السحري بالسحر"
  },
  {
   "i": 98,
   "start": 272.495,
   "end": 274.194,
   "text": "هي من عمل الشيطان"
  },
  {
   "i": 99,
   "start": 274.194,
   "end": 274.591,
   "text": "ونحن"
  },
  {
   "i": 100,
   "start": 274.591,
   "end": 276.0,
   "text": "فما الطريق الصحيح"
  },
  {
   "i": 101,
   "start": 276.0,
   "end": 276.421,
   "text": "اتصال"
  },
  {
   "i": 102,
   "start": 276.421,
   "end": 279.325,
   "text": "إذا لم يكن اليقين ممكنا فالجواب بسي"
  },
  {
   "i": 103,
   "start": 279.325,
   "end": 290.144,
   "text": "الرقية الشرعية فهي اختبار وعلاج في آن واحد فإن كان ثمت سحر أبطله الله بإذنه وإن لم يكن فهي ذكر وشفاء وبركة لا ضرر في"
  },
  {
   "i": 104,
   "start": 290.144,
   "end": 297.133,
   "text": "ويذكروا الروقات أن المسحور قد يجد أثناء الرقية ثقلا أو تثائبا متتابعا أو دموع"
  },
  {
   "i": 105,
   "start": 297.133,
   "end": 299.923,
   "text": "ثم يجد بعد جلسات خفة وراحة"
  },
  {
   "i": 106,
   "start": 299.923,
   "end": 300.247,
   "text": "(تصم"
  },
  {
   "i": 107,
   "start": 300.247,
   "end": 301.737,
   "text": "وهذا هو البرنامج"
  },
  {
   "i": 108,
   "start": 301.737,
   "end": 302.139,
   "text": "بي"
  },
  {
   "i": 109,
   "start": 302.139,
   "end": 302.871,
   "text": "أولاً"
  },
  {
   "i": 110,
   "start": 302.871,
   "end": 304.351,
   "text": "آيات ابطال السحر"
  },
  {
   "i": 111,
   "start": 304.351,
   "end": 308.205,
   "text": "تقرأها على نفسك أو على الماء من سورة الأعراف"
  },
  {
   "i": 112,
   "start": 308.205,
   "end": 316.555,
   "text": "وأوحينا إلى موسى أن ألق عصاك فإذا هي تلقف ما يأفكون فوقع الحق وبطل ما كانوا يعملون"
  },
  {
   "i": 113,
   "start": 316.555,
   "end": 323.976,
   "text": "ومن سورة يونوس، ما جئت به السحر إن الله سيبطله إن الله لا يصلح عمل المفسدين"
  },
  {
   "i": 114,
   "start": 323.976,
   "end": 325.584,
   "text": "ومن سورة طهة"
  },
  {
   "i": 115,
   "start": 325.584,
   "end": 334.969,
   "text": "إنما صنع كيد ساحر ولا يفلح الساحر حيث أتا ومعها فاتحتوا آية الكرسي وخواتيم البقرة والإخلاص والفلق والنا"
  },
  {
   "i": 116,
   "start": 334.969,
   "end": 335.385,
   "text": "بحق"
  },
  {
   "i": 117,
   "start": 335.385,
   "end": 336.091,
   "text": "ثانياً"
  },
  {
   "i": 118,
   "start": 336.091,
   "end": 337.673,
   "text": "الماء وورق السدر"
  },
  {
   "i": 119,
   "start": 337.673,
   "end": 341.154,
   "text": "رويا عن بعض السلف ونقله ابن حجر في فتح البار"
  },
  {
   "i": 120,
   "start": 341.154,
   "end": 345.193,
   "text": "أن تدق 7 ورقات خضر من السدر وتضع في ماء"
  },
  {
   "i": 121,
   "start": 345.193,
   "end": 348.969,
   "text": "ويقرأ عليها آية الكرسي والمعودات وآيات السح"
  },
  {
   "i": 122,
   "start": 348.969,
   "end": 352.745,
   "text": "ثم يشرب منه ثلاث حسوات ويغتسر بالباقي"
  },
  {
   "i": 123,
   "start": 352.745,
   "end": 356.767,
   "text": "ثالثا سورة البقرة"
  },
  {
   "i": 124,
   "start": 356.767,
   "end": 361.168,
   "text": "اقرأ سورة البقرة فإن أخذها بركة وطركها حسرة"
  },
  {
   "i": 125,
   "start": 361.168,
   "end": 362.98,
   "text": "ولا يستطيع هالبطلة"
  },
  {
   "i": 126,
   "start": 362.98,
   "end": 364.553,
   "text": "والبطلهم السحرة"
  },
  {
   "i": 127,
   "start": 364.553,
   "end": 366.513,
   "text": "لا يطيقون سورة البقرة"
  },
  {
   "i": 128,
   "start": 366.513,
   "end": 368.654,
   "text": "رابعا تمر العجوة"
  },
  {
   "i": 129,
   "start": 368.654,
   "end": 372.933,
   "text": "قال صلى الله عليه وسلم من تصبح كل يوم سبعة مرات عجوة"
  },
  {
   "i": 130,
   "start": 372.933,
   "end": 376.143,
   "text": "لم يضره في ذلك اليوم صم ولا سحر"
  },
  {
   "i": 131,
   "start": 376.143,
   "end": 380.487,
   "text": "خامسا أذكر الصباح والمساء والمحافظة عن الصلاة"
  },
  {
   "i": 132,
   "start": 380.487,
   "end": 385.243,
   "text": "ومعها هذا الذكر مئة مرة في اليوم فهو حيرز من الشيطان حتى المس"
  },
  {
   "i": 133,
   "start": 385.243,
   "end": 389.538,
   "text": "لا إله إلا الله وحده لا شريك له له الملك وله الحمد"
  },
  {
   "i": 134,
   "start": 389.538,
   "end": 391.618,
   "text": "وهو على كل شيء قدير"
  },
  {
   "i": 135,
   "start": 391.618,
   "end": 392.814,
   "text": "سادسن"
  },
  {
   "i": 136,
   "start": 392.814,
   "end": 393.774,
   "text": "الصبر"
  },
  {
   "i": 137,
   "start": 393.774,
   "end": 397.076,
   "text": "فعلاج السحر قد يستغرق أسابيع وأشخرا"
  },
  {
   "i": 138,
   "start": 397.076,
   "end": 400.818,
   "text": "فلا تيس ولا ترجع من طريق الشرعي إلى طريق السحرة"
  },
  {
   "i": 139,
   "start": 400.818,
   "end": 402.037,
   "text": "فينسألت"
  },
  {
   "i": 140,
   "start": 402.037,
   "end": 403.989,
   "text": "كيف أعرف أني مسحور؟"
  },
  {
   "i": 141,
   "start": 403.989,
   "end": 404.986,
   "text": "فالجواب"
  },
  {
   "i": 142,
   "start": 404.986,
   "end": 407.573,
   "text": "يعرف العلمات ولا تحكم بها"
  },
  {
   "i": 143,
   "start": 407.573,
   "end": 410.323,
   "text": "ولا تذهب إلى من يدعي علم الغيب"
  },
  {
   "i": 144,
   "start": 410.323,
   "end": 412.192,
   "text": "ولا تتهم أحداً"
  },
  {
   "i": 145,
   "start": 412.192,
   "end": 416.583,
   "text": "وبدأ بالرقية الشرعية فإن كان سحر فقد وعد الله"
  },
  {
   "i": 146,
   "start": 416.583,
   "end": 418.393,
   "text": "إن الله سيبطل"
  },
  {
   "i": 147,
   "start": 418.393,
   "end": 421.512,
   "text": "أرسل هذا المقطع لمن يعيش في هذا الخوف"
  },
  {
   "i": 148,
   "start": 421.512,
   "end": 423.003,
   "text": "وكتب في التعليقات"
  },
  {
   "i": 149,
   "start": 423.003,
   "end": 426.365,
   "text": "اللهم فك كل عقدة وسحر عن حياتنا"
  },
  {
   "i": 150,
   "start": 426.365,
   "end": 427.2,
   "text": "أمين"
  }
 ]
}