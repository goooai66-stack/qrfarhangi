 "segs": [
  {
   "i": 0,
   "start": 0.0,
   "end": 3.229,
   "text": "أشعر في الليل أن أحدا معي في الغرفة"
  },
  {
   "i": 1,
   "start": 3.229,
   "end": 6.954,
   "text": "كلما سمعت القرآن ثقل جسدي كله"
  },
  {
   "i": 2,
   "start": 6.954,
   "end": 8.918,
   "text": "أرأى حلاما أخاف منها"
  },
  {
   "i": 3,
   "start": 8.918,
   "end": 9.389,
   "text": "بحق"
  },
  {
   "i": 4,
   "start": 9.389,
   "end": 11.649,
   "text": "أي بارات يسمعها الرقات كثيرا"
  },
  {
   "i": 5,
   "start": 11.649,
   "end": 14.227,
   "text": "وبراها جميعا سؤال واحد"
  },
  {
   "i": 6,
   "start": 14.227,
   "end": 16.049,
   "text": "هل في جسدي جني؟"
  },
  {
   "i": 7,
   "start": 16.049,
   "end": 20.75,
   "text": "نتوقف اليوم مع القرآن والسنة وتجارب أهل العلم بالرقية لن"
  },
  {
   "i": 8,
   "start": 20.75,
   "end": 21.074,
   "text": "سنقوم"
  },
  {
   "i": 9,
   "start": 21.074,
   "end": 23.847,
   "text": "هل يدخل الجنني جسد الإنسان أصلا"
  },
  {
   "i": 10,
   "start": 23.847,
   "end": 26.115,
   "text": "وما العلمات التي يذكرها الرقاة"
  },
  {
   "i": 11,
   "start": 26.115,
   "end": 29.221,
   "text": "وما الذي يجب أن لا نصدقه أبداً؟"
  },
  {
   "i": 12,
   "start": 29.221,
   "end": 31.592,
   "text": "وما طريق العلاج الشرعي"
  },
  {
   "i": 13,
   "start": 31.592,
   "end": 33.784,
   "text": "هل يدخل الجنية وجسد الإنس"
  },
  {
   "i": 14,
   "start": 33.784,
   "end": 36.074,
   "text": "قال تعالى عن أكل ربة"
  },
  {
   "i": 15,
   "start": 36.074,
   "end": 42.661,
   "text": "الذين يأكلون الربا لا يقومون إلا كما يقوم الذي يتخبطه الشيطان من المس"
  },
  {
   "i": 16,
   "start": 42.661,
   "end": 48.218,
   "text": "وقال النبي صلى الله عليه وسلم إن الشيطان يجري من ابن آدم مجر الدم"
  },
  {
   "i": 17,
   "start": 48.218,
   "end": 50.801,
   "text": "وعلى هذا أكثر علماء أهل السنة"
  },
  {
   "i": 18,
   "start": 50.801,
   "end": 53.796,
   "text": "أن الجنية قد يؤذ الإنسان ويدخل بدنا"
  },
  {
   "i": 19,
   "start": 53.796,
   "end": 60.332,
   "text": "وقيل للإمام أحمد بن حنبل إن قوم يقولون إن الجنية لا يدخل بدن الإنسي"
  },
  {
   "i": 20,
   "start": 60.332,
   "end": 61.196,
   "text": "فقال"
  },
  {
   "i": 21,
   "start": 61.196,
   "end": 62.178,
   "text": "يكذبون"
  },
  {
   "i": 22,
   "start": 62.178,
   "end": 64.16,
   "text": "هو ذا يتكلم على لسانه"
  },
  {
   "i": 23,
   "start": 64.16,
   "end": 64.603,
   "text": "اتصال"
  },
  {
   "i": 24,
   "start": 64.603,
   "end": 69.167,
   "text": "لكن العلماء أنفسهم قرروا أن ذلك لا يكون إلا بإذن الله"
  },
  {
   "i": 25,
   "start": 69.167,
   "end": 73.406,
   "text": "وان الشيطان لا سلطان له على عبد تحصن بذكر ربه"
  },
  {
   "i": 26,
   "start": 73.406,
   "end": 77.806,
   "text": "قال تعالى إن عباد ليس لك عليهم سلطان"
  },
  {
   "i": 27,
   "start": 77.806,
   "end": 85.516,
   "text": "علامات في النوم ذكر الرقاء ومنهم الشيخ وحيدا عبد السلام بالي في كتبه علامات في نوم من أذاه الجن"
  },
  {
   "i": 28,
   "start": 85.516,
   "end": 88.206,
   "text": "الأرق وكثرة الاستيقاض في الليل"
  },
  {
   "i": 29,
   "start": 88.206,
   "end": 90.371,
   "text": "رؤى القلق والخوف عند النوم"
  },
  {
   "i": 30,
   "start": 90.371,
   "end": 91.778,
   "text": "كوابيسم تكرر"
  },
  {
   "i": 31,
   "start": 91.778,
   "end": 97.99,
   "text": "وبخاصة رؤية القطط أو الكلاب أو الثعبين أو الجمال أو حيوانات مخيفة هاجم النائ"
  },
  {
   "i": 32,
   "start": 97.99,
   "end": 100.365,
   "text": "رؤية النفس تسقط من مكانا عالي"
  },
  {
   "i": 33,
   "start": 100.365,
   "end": 104.451,
   "text": "رؤية المقابر أو الخراعب أو طرق مظلمة لنهاية له"
  },
  {
   "i": 34,
   "start": 104.451,
   "end": 107.343,
   "text": "الكلام أو الضحك أو الصراق في أثناء النوم"
  },
  {
   "i": 35,
   "start": 107.343,
   "end": 109.144,
   "text": "والمشي في أتنع النوم"
  },
  {
   "i": 36,
   "start": 109.144,
   "end": 109.638,
   "text": "اشتركوا"
  },
  {
   "i": 37,
   "start": 109.638,
   "end": 111.191,
   "text": "وعلمات في اليقر"
  },
  {
   "i": 38,
   "start": 111.191,
   "end": 124.481,
   "text": "ضيق ونفور مفاجئ عند سماع الأذان أو القرآن غضب مفاجئ شديد لا يشبه طبع الإنسان تشتت الذهن وكثرة نسيان ثقل وخدر في عضو من الجسد يتغير مع الذك"
  },
  {
   "i": 39,
   "start": 124.481,
   "end": 128.163,
   "text": "الشعور بوجود أحد في المكان وبخاصة في الخلوة"
  },
  {
   "i": 40,
   "start": 128.163,
   "end": 132.093,
   "text": "والبعد عن الصلاة والعبادة دون أن يعرف صحيبه السبب"
  },
  {
   "i": 41,
   "start": 132.093,
   "end": 132.666,
   "text": "ونحن ن"
  },
  {
   "i": 42,
   "start": 132.666,
   "end": 134.753,
   "text": "وعلمات عند الرقيا"
  },
  {
   "i": 43,
   "start": 134.753,
   "end": 138.791,
   "text": "يقول الرقاء إن أهم العلمات ما يظهر عند سماع الرقية"
  },
  {
   "i": 44,
   "start": 138.791,
   "end": 141.358,
   "text": "قشعريرة أو راشة في الجسد"
  },
  {
   "i": 45,
   "start": 141.358,
   "end": 143.971,
   "text": "وخدر أو ثقل في اليدين والقدمين"
  },
  {
   "i": 46,
   "start": 143.971,
   "end": 146.265,
   "text": "وبكاء أوضحكم بلا إرادة"
  },
  {
   "i": 47,
   "start": 146.265,
   "end": 147.315,
   "text": "وصراح"
  },
  {
   "i": 48,
   "start": 147.315,
   "end": 148.714,
   "text": "وفي الحلات الأشد"
  },
  {
   "i": 49,
   "start": 148.714,
   "end": 150.524,
   "text": "الكلام بصوت آخر"
  },
  {
   "i": 50,
   "start": 150.524,
   "end": 159.115,
   "text": "لكن يعلم أن تثاؤب أو الدموع أو القشعلي روحدها ليس الدليلا على وجود جنيه فقد تكون أثر القرآن في القلب لا غير"
  },
  {
   "i": 51,
   "start": 159.115,
   "end": 159.662,
   "text": "اتصال"
  },
  {
   "i": 52,
   "start": 159.662,
   "end": 163.528,
   "text": "وهنا أهم ما في الحلقة ليس كل حال مساً"
  },
  {
   "i": 53,
   "start": 163.528,
   "end": 166.523,
   "text": "لا شيء من هذه العلامات وحده دل نقاطة"
  },
  {
   "i": 54,
   "start": 166.523,
   "end": 170.907,
   "text": "فالكوابيس والأرق والغضب والحزن لها أسباب كثيرة"
  },
  {
   "i": 55,
   "start": 170.907,
   "end": 172.9,
   "text": "ونسبة كل حال إلى الجن"
  },
  {
   "i": 56,
   "start": 172.9,
   "end": 174.28,
   "text": "والمل النفس"
  },
  {
   "i": 57,
   "start": 174.28,
   "end": 175.725,
   "text": "وفي صحيح البخري"
  },
  {
   "i": 58,
   "start": 175.725,
   "end": 179.918,
   "text": "أن مرأة سوداء جاءت النبي صلى الله عليه وسلم فقالت"
  },
  {
   "i": 59,
   "start": 179.918,
   "end": 180.964,
   "text": "إني أصرا"
  },
  {
   "i": 60,
   "start": 180.964,
   "end": 182.257,
   "text": "وإني أتكشف"
  },
  {
   "i": 61,
   "start": 182.257,
   "end": 183.334,
   "text": "فدعوا الله لي"
  },
  {
   "i": 62,
   "start": 183.334,
   "end": 184.051,
   "text": "فقال"
  },
  {
   "i": 63,
   "start": 184.051,
   "end": 185.935,
   "text": "انشأتي صبارتي ولكن الجنة"
  },
  {
   "i": 64,
   "start": 185.935,
   "end": 188.663,
   "text": "وإنشئت دعوط الله أن يعافيك"
  },
  {
   "i": 65,
   "start": 188.663,
   "end": 189.942,
   "text": "فقالت أصبر"
  },
  {
   "i": 66,
   "start": 189.942,
   "end": 192.406,
   "text": "ولكن ادعوا الله الى اتكشف"
  },
  {
   "i": 67,
   "start": 192.406,
   "end": 193.543,
   "text": "فدع لها"
  },
  {
   "i": 68,
   "start": 193.543,
   "end": 194.533,
   "text": "تأمل"
  },
  {
   "i": 69,
   "start": 194.533,
   "end": 200.745,
   "text": "لم يقلها النبي صلى الله عليه وسلم هذا من فعل فلان بل دلها على الصبر والدعاء والجنة"
  },
  {
   "i": 70,
   "start": 200.745,
   "end": 203.758,
   "text": "ثلاثة أمور لا تصدقها أبدًا"
  },
  {
   "i": 71,
   "start": 203.758,
   "end": 204.596,
   "text": "الأول"
  },
  {
   "i": 72,
   "start": 204.596,
   "end": 206.163,
   "text": "لا تصدق كلام الجني"
  },
  {
   "i": 73,
   "start": 206.163,
   "end": 210.007,
   "text": "أحيانا يتكلم أحدهم أثناء الرقية بصوط آخر"
  },
  {
   "i": 74,
   "start": 210.007,
   "end": 216.173,
   "text": "ويقول فلان سحر أو أم زوجها أرسلتني أو السحر متفون في المكان فلاني"
  },
  {
   "i": 75,
   "start": 216.173,
   "end": 218.29,
   "text": "لا تصدق شيئ من ذلك"
  },
  {
   "i": 76,
   "start": 218.29,
   "end": 221.178,
   "text": "فحين علم الشيطان أباه ريرا آية الكر"
  },
  {
   "i": 77,
   "start": 221.178,
   "end": 225.067,
   "text": "قال النبي صلى الله عليه وسلم صدقك وهو كذوب"
  },
  {
   "i": 78,
   "start": 225.067,
   "end": 226.803,
   "text": "فإذا كان الشيطان كذوبا"
  },
  {
   "i": 79,
   "start": 226.803,
   "end": 229.2,
   "text": "فكيف نتهم أسرة بكلامه؟"
  },
  {
   "i": 80,
   "start": 229.2,
   "end": 230.349,
   "text": "أثاني"
  },
  {
   "i": 81,
   "start": 230.349,
   "end": 232.681,
   "text": "الضرب والخنق ليس رقيا"
  },
  {
   "i": 82,
   "start": 232.681,
   "end": 238.089,
   "text": "بعضهم يضرب المريض باسم إخراج الجني أو يضغط على عنقه أو يكويه"
  },
  {
   "i": 83,
   "start": 238.089,
   "end": 240.024,
   "text": "وليس هذا من السنة في شيء"
  },
  {
   "i": 84,
   "start": 240.024,
   "end": 247.853,
   "text": "كانت رقية النبي صلى الله عليه وسلم قرآن ودعاء ونفثاً لطيفاً ومسحاً باليد لا ضرباً ولا إذان"
  },
  {
   "i": 85,
   "start": 247.853,
   "end": 253.158,
   "text": "والضربة التي تقعوا على المريض تقعوا على بدن الإنسان نفسه لا على الجنّي"
  },
  {
   "i": 86,
   "start": 253.158,
   "end": 256.082,
   "text": "ثالث، الخلوة ومسس الأجنبية"
  },
  {
   "i": 87,
   "start": 256.082,
   "end": 260.574,
   "text": "لا يحل لراق أن يخل و بمرأة أجنبية ولا أن يمس بدناها"
  },
  {
   "i": 88,
   "start": 260.574,
   "end": 263.357,
   "text": "رقية المرأة تكون بحضور محرمها"
  },
  {
   "i": 89,
   "start": 263.357,
   "end": 266.378,
   "text": "وبحجابها الكامل ومن غير لمس"
  },
  {
   "i": 90,
   "start": 266.378,
   "end": 269.28,
   "text": "وما لم يلتزم هذه الحدود فليس براق"
  },
  {
   "i": 91,
   "start": 269.28,
   "end": 271.004,
   "text": "فقومي وانصرفي"
  },
  {
   "i": 92,
   "start": 271.004,
   "end": 272.65,
   "text": "خير راق لك"
  },
  {
   "i": 93,
   "start": 272.65,
   "end": 273.577,
   "text": "أنت"
  },
  {
   "i": 94,
   "start": 273.577,
   "end": 282.919,
   "text": "قال النبي صلى الله عليه وسلم في السبعين ألفاً الذين يدخلون الجنة بغير حساب هم الذين لا يسترقون ولا يتطيرون"
  },
  {
   "i": 95,
   "start": 282.919,
   "end": 284.941,
   "text": "وعلى ربهم يتوكلون"
  },
  {
   "i": 96,
   "start": 284.941,
   "end": 287.597,
   "text": "أي لا يطلبون الرقية من غيرهم"
  },
  {
   "i": 97,
   "start": 287.597,
   "end": 293.111,
   "text": "فأفضل الحال أن ترقي نفسك بنفسك فأنت أقرب إلى الله مما تظن"
  },
  {
   "i": 98,
   "start": 293.111,
   "end": 295.493,
   "text": "والقرآن نزل لك أيضاً"
  },
  {
   "i": 99,
   "start": 295.493,
   "end": 297.99,
   "text": "وهذا برنامج الرقاتي على النفس"
  },
  {
   "i": 100,
   "start": 297.99,
   "end": 298.857,
   "text": "توضى"
  },
  {
   "i": 101,
   "start": 298.857,
   "end": 302.532,
   "text": "واجد لس مستقبل القبلة وضع يدك اليومنا على صد"
  },
  {
   "i": 102,
   "start": 302.532,
   "end": 304.663,
   "text": "أو على موضع الألم، وقرأ"
  },
  {
   "i": 103,
   "start": 304.663,
   "end": 305.81,
   "text": "الفاتحة"
  },
  {
   "i": 104,
   "start": 305.81,
   "end": 307.193,
   "text": "وآية الكرسي"
  },
  {
   "i": 105,
   "start": 307.193,
   "end": 310.108,
   "text": "وأول سورة البقرة وخواتيمة"
  },
  {
   "i": 106,
   "start": 310.108,
   "end": 315.443,
   "text": "والآيات من الرابعة والخمسين إلى السادسة والخمسين من سورة الأعراف"
  },
  {
   "i": 107,
   "start": 315.443,
   "end": 319.983,
   "text": "والآيات من الخامسة عشر بعد المئة إلى آخر سورة المؤمنون"
  },
  {
   "i": 108,
   "start": 319.983,
   "end": 323.067,
   "text": "وأول سورة الصافات إلى الآية العاشرة"
  },
  {
   "i": 109,
   "start": 323.067,
   "end": 324.18,
   "text": "والإخلاص"
  },
  {
   "i": 110,
   "start": 324.18,
   "end": 325.065,
   "text": "والفلق"
  },
  {
   "i": 111,
   "start": 325.065,
   "end": 325.913,
   "text": "ونس"
  },
  {
   "i": 112,
   "start": 325.913,
   "end": 327.429,
   "text": "ثلاثا ثلاثا"
  },
  {
   "i": 113,
   "start": 327.429,
   "end": 328.738,
   "text": "وبعد كل صورة"
  },
  {
   "i": 114,
   "start": 328.738,
   "end": 330.155,
   "text": "أمفذ في يديك برف"
  },
  {
   "i": 115,
   "start": 330.155,
   "end": 332.036,
   "text": "ومسح بهما جسدك"
  },
  {
   "i": 116,
   "start": 332.036,
   "end": 335.693,
   "text": "وقرأ الآيات نفسها على الماء وشرب منه وغتسل"
  },
  {
   "i": 117,
   "start": 335.693,
   "end": 342.827,
   "text": "وقرأ سورة البقرة في بيتك فقد أخبر صلى الله عليه وسلم أن الشيطان ينفر من البيت التي تقرأ فيه"
  },
  {
   "i": 118,
   "start": 342.827,
   "end": 344.135,
   "text": "أبواب"
  },
  {
   "i": 119,
   "start": 344.135,
   "end": 346.084,
   "text": "يجب أن تبقى مغلقة"
  },
  {
   "i": 120,
   "start": 346.084,
   "end": 350.764,
   "text": "دلنا النبي صلى الله عليه وسلم على أبواب ينبغي أن نغلقها"
  },
  {
   "i": 121,
   "start": 350.764,
   "end": 351.126,
   "text": "بي"
  },
  {
   "i": 122,
   "start": 351.126,
   "end": 351.976,
   "text": "عند الخضب"
  },
  {
   "i": 123,
   "start": 351.976,
   "end": 354.819,
   "text": "قل أعوذ بالله من الشيطان الرجيم"
  },
  {
   "i": 124,
   "start": 354.819,
   "end": 360.904,
   "text": "فقد قال صلى الله عليه وسلم عن رجل غطبان إنه لو قالها لذهب عنه ما يجد"
  },
  {
   "i": 125,
   "start": 360.904,
   "end": 363.217,
   "text": "عند التثائب غطي فمك"
  },
  {
   "i": 126,
   "start": 363.217,
   "end": 367.278,
   "text": "قال صلى الله عليه وسلم فاليمسك بيده على فيه"
  },
  {
   "i": 127,
   "start": 367.278,
   "end": 368.759,
   "text": "فإن الشيطان يدخل"
  },
  {
   "i": 128,
   "start": 368.759,
   "end": 374.27,
   "text": "عند دخول الخلاء قل اللهم إني أعوذ بك من الخبث والخبائث"
  },
  {
   "i": 129,
   "start": 374.27,
   "end": 377.066,
   "text": "وفي الصباح والمساء لا تترك الأذكر"
  },
  {
   "i": 130,
   "start": 377.066,
   "end": 378.932,
   "text": "وقل مئة مرة في اليوم"
  },
  {
   "i": 131,
   "start": 378.932,
   "end": 381.009,
   "text": "فهي حرز لك حتى تمسي"
  },
  {
   "i": 132,
   "start": 381.009,
   "end": 383.203,
   "text": "لا إله إلا الله وحده"
  },
  {
   "i": 133,
   "start": 383.203,
   "end": 384.428,
   "text": "لا شريك له"
  },
  {
   "i": 134,
   "start": 384.428,
   "end": 386.121,
   "text": "له الملك وله الحمد"
  },
  {
   "i": 135,
   "start": 386.121,
   "end": 388.493,
   "text": "وهو على كل شيء قدير"
  },
  {
   "i": 136,
   "start": 388.493,
   "end": 391.831,
   "text": "فإن سألت كيف أعرف أن في جسدي جنين؟"
  },
  {
   "i": 137,
   "start": 391.831,
   "end": 394.404,
   "text": "فعرف العلمات ولا تحكم بها"
  },
  {
   "i": 138,
   "start": 394.404,
   "end": 396.572,
   "text": "ولا تصدق كلام الجني"
  },
  {
   "i": 139,
   "start": 396.572,
   "end": 400.37,
   "text": "ولا تعد من يضرب أو ينتهك الحرمات راقياً"
  },
  {
   "i": 140,
   "start": 400.37,
   "end": 402.233,
   "text": "وبدأ الرقية بنفسك"
  },
  {
   "i": 141,
   "start": 402.233,
   "end": 407.425,
   "text": "موقنا بقول الله تعالى إن كيد الشيطان كان ضعيفا"
  },
  {
   "i": 142,
   "start": 407.425,
   "end": 410.096,
   "text": "أرسل هذا المقطع لمن يعيش هذا الخوف"
  },
  {
   "i": 143,
   "start": 410.096,
   "end": 414.446,
   "text": "وقت في تعليقات اللهم احفظنا من شياطين الجني والإنس"
  },
  {
   "i": 144,
   "start": 414.446,
   "end": 415.32,
   "text": "أميين"
  }
 ]
}