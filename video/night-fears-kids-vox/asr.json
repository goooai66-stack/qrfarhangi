 "segs": [
  {
   "i": 0,
   "start": 0.0,
   "end": 1.378,
   "text": "في هدأة الليل"
  },
  {
   "i": 1,
   "start": 1.378,
   "end": 4.087,
   "text": "يرتفع صراخ من غرفة الصغار"
  },
  {
   "i": 2,
   "start": 4.087,
   "end": 7.484,
   "text": "تهرع الأم فتجد طفلها جالسا في فراش"
  },
  {
   "i": 3,
   "start": 7.484,
   "end": 8.442,
   "text": "يرتجف"
  },
  {
   "i": 4,
   "start": 8.442,
   "end": 10.613,
   "text": "ويشير إلى زاوية الغرفة"
  },
  {
   "i": 5,
   "start": 10.613,
   "end": 12.164,
   "text": "هناك شيئ"
  },
  {
   "i": 6,
   "start": 12.164,
   "end": 14.29,
   "text": "تضمه وتهدئه"
  },
  {
   "i": 7,
   "start": 14.29,
   "end": 16.991,
   "text": "ثم تتكرر القصة في الليلة التالية"
  },
  {
   "i": 8,
   "start": 16.991,
   "end": 18.587,
   "text": "والتي بعدها"
  },
  {
   "i": 9,
   "start": 18.587,
   "end": 21.04,
   "text": "طفل كان ينام قرير العين"
  },
  {
   "i": 10,
   "start": 21.04,
   "end": 22.654,
   "text": "صار يخاف الضلام"
  },
  {
   "i": 11,
   "start": 22.654,
   "end": 24.483,
   "text": "ولا يقبل أن يبقى وحده"
  },
  {
   "i": 12,
   "start": 24.483,
   "end": 26.697,
   "text": "واستقذ مرات في الليل"
  },
  {
   "i": 13,
   "start": 26.697,
   "end": 30.611,
   "text": "إن كانت هذه لياليكم فهذه الحلقة لكم"
  },
  {
   "i": 14,
   "start": 30.611,
   "end": 35.435,
   "text": "سنمشي معاً مع حدي النبي صلى الله عليه وسلم في ليل الأطفال"
  },
  {
   "i": 15,
   "start": 35.435,
   "end": 36.922,
   "text": "من غروب الشمس"
  },
  {
   "i": 16,
   "start": 36.922,
   "end": 38.344,
   "text": "إلى اللحظة النوم"
  },
  {
   "i": 17,
   "start": 38.344,
   "end": 43.451,
   "text": "إلى اللحظة التي يستيقظ فيها الصغير مذعورا من حلم مخيف"
  },
  {
   "i": 18,
   "start": 43.451,
   "end": 45.956,
   "text": "نبدأ من ساعة الغروب"
  },
  {
   "i": 19,
   "start": 45.956,
   "end": 48.913,
   "text": "قال رسول الله صلى الله عليه وسلم"
  },
  {
   "i": 20,
   "start": 48.913,
   "end": 50.673,
   "text": "إذا كان جنح الليل"
  },
  {
   "i": 21,
   "start": 50.673,
   "end": 52.248,
   "text": "فكوفوا سبيانكم"
  },
  {
   "i": 22,
   "start": 52.248,
   "end": 54.789,
   "text": "فإن الشياطين تنتشر حين إذن"
  },
  {
   "i": 23,
   "start": 54.789,
   "end": 57.899,
   "text": "فإذا ذهب ساعة من الليل فخلوهم"
  },
  {
   "i": 24,
   "start": 57.899,
   "end": 60.557,
   "text": "وأغلق الأبواب وذكر اسم الله"
  },
  {
   "i": 25,
   "start": 60.557,
   "end": 63.383,
   "text": "فإن الشيطان لا يفتح باب مغلقا"
  },
  {
   "i": 26,
   "start": 63.383,
   "end": 65.672,
   "text": "لاحظوا دقة هذا التوجيه"
  },
  {
   "i": 27,
   "start": 65.672,
   "end": 68.087,
   "text": "لم يأمرنا أن نخاف من الظلام"
  },
  {
   "i": 28,
   "start": 68.087,
   "end": 71.603,
   "text": "بل أن نبقي أطفالنا قريبين مننا في تلك الساعة"
  },
  {
   "i": 29,
   "start": 71.603,
   "end": 74.089,
   "text": "وأن نغلق بيوتنا بسم الله"
  },
  {
   "i": 30,
   "start": 74.089,
   "end": 77.019,
   "text": "فعند المغرب ادخل صغراء الى البيت"
  },
  {
   "i": 31,
   "start": 77.019,
   "end": 79.333,
   "text": "وكلما أغلقت بابا فقول"
  },
  {
   "i": 32,
   "start": 79.333,
   "end": 80.637,
   "text": "بسم الله"
  },
  {
   "i": 33,
   "start": 80.637,
   "end": 83.918,
   "text": "ثم بيت لا مبيت فيه للشيطان"
  },
  {
   "i": 34,
   "start": 83.918,
   "end": 91.612,
   "text": "أخبر النبي صلى الله عليه وسلم أن الرجل إذا دخل بيته فذكر الله عند دخوله وعند طعامه"
  },
  {
   "i": 35,
   "start": 91.612,
   "end": 95.821,
   "text": "قال الشيطان لأصحابه لا مبيت لكم ولا عشق"
  },
  {
   "i": 36,
   "start": 95.821,
   "end": 100.457,
   "text": "علموا أطفالكم أن يطولوا بسم الله عند دخول البيت"
  },
  {
   "i": 37,
   "start": 100.457,
   "end": 102.337,
   "text": "وبسم الله على المائدة"
  },
  {
   "i": 38,
   "start": 102.337,
   "end": 106.829,
   "text": "عادات صغيرة لكنها تحصّن البيت من الداخل"
  },
  {
   "i": 39,
   "start": 106.829,
   "end": 113.722,
   "text": "وأخبر صلى الله عليه وسلم أن الشيطان ينفر من البيت الذي تقرأ فيه سورة البقرة"
  },
  {
   "i": 40,
   "start": 113.722,
   "end": 114.076,
   "text": "(تحدي"
  },
  {
   "i": 41,
   "start": 114.076,
   "end": 122.195,
   "text": "فإن لم تستطيع قرأتها كاملة كل يوم فأسمع البيت تلاوتها ودع الصغير ينشأ على صوت القرآن"
  },
  {
   "i": 42,
   "start": 122.195,
   "end": 122.672,
   "text": "(تصميم"
  },
  {
   "i": 43,
   "start": 122.672,
   "end": 125.312,
   "text": "ثم تأتي أهم دقائق الليل"
  },
  {
   "i": 44,
   "start": 125.312,
   "end": 126.815,
   "text": "لحظة النوم"
  },
  {
   "i": 45,
   "start": 126.815,
   "end": 133.851,
   "text": "قال صلى الله عليه وسلم لأحد أصحابه إذا أتيت مجعك فتوضّأ ودوءك للصلاة"
  },
  {
   "i": 46,
   "start": 133.851,
   "end": 136.065,
   "text": "ثم التجع على شقك الأيمن"
  },
  {
   "i": 47,
   "start": 136.065,
   "end": 136.4,
   "text": "بخير"
  },
  {
   "i": 48,
   "start": 136.4,
   "end": 140.743,
   "text": "فإن كان طفلكم كبيرا فعلموه ذلك كأنها لعبة لطيف"
  },
  {
   "i": 49,
   "start": 140.743,
   "end": 141.43,
   "text": "وضو"
  },
  {
   "i": 50,
   "start": 141.43,
   "end": 143.31,
   "text": "ثم نوم على جنب الإيمن"
  },
  {
   "i": 51,
   "start": 143.31,
   "end": 151.99,
   "text": "وكانت عائشة رضي الله عنها تحكي أن النبي صلى الله عليه وسلم كان إذا آوى إلى فراشه كل ليلة جمع كفيه"
  },
  {
   "i": 52,
   "start": 151.99,
   "end": 158.732,
   "text": "ثم نفث فيهما وقرأ الإخلاص والفلق والناس ثم مسح بهم مستطع من جسده"
  },
  {
   "i": 53,
   "start": 158.732,
   "end": 160.45,
   "text": "يبدأ برأسه ووجه"
  },
  {
   "i": 54,
   "start": 160.45,
   "end": 163.014,
   "text": "يفعل ذلك ثلاثة مرات"
  },
  {
   "i": 55,
   "start": 163.014,
   "end": 163.513,
   "text": "اتصال"
  },
  {
   "i": 56,
   "start": 163.513,
   "end": 166.399,
   "text": "فجلسوا كل ليلة بجوار سرير الطفل"
  },
  {
   "i": 57,
   "start": 166.399,
   "end": 174.162,
   "text": "وقرأوا الإخلاص والفلق والناس وانفذوا في أيديكم وامسحوا برفق على رأسه ووجهه وجسته"
  },
  {
   "i": 58,
   "start": 174.162,
   "end": 175.332,
   "text": "ثلاثا"
  },
  {
   "i": 59,
   "start": 175.332,
   "end": 177.854,
   "text": "تمقرأوا آية الكرسي"
  },
  {
   "i": 60,
   "start": 177.854,
   "end": 178.686,
   "text": "ف.."
  },
  {
   "i": 61,
   "start": 178.686,
   "end": 182.529,
   "text": "فمن قرىها عند نومه لم يزل عليه من الله حافظ"
  },
  {
   "i": 62,
   "start": 182.529,
   "end": 185.319,
   "text": "ولا يقربه شيطان حتى يصبح"
  },
  {
   "i": 63,
   "start": 185.319,
   "end": 187.371,
   "text": "وقرأ خواتي مسورة البقرة"
  },
  {
   "i": 64,
   "start": 187.371,
   "end": 189.652,
   "text": "فمن قرأهما في ليلة كفته"
  },
  {
   "i": 65,
   "start": 189.652,
   "end": 190.704,
   "text": "وفي الختم"
  },
  {
   "i": 66,
   "start": 190.704,
   "end": 192.397,
   "text": "قول في أذنه بهدوء"
  },
  {
   "i": 67,
   "start": 192.397,
   "end": 194.591,
   "text": "أو قلوها معه إن كان كبيراً"
  },
  {
   "i": 68,
   "start": 194.591,
   "end": 197.34,
   "text": "بسمك الله مأموت وأحيا"
  },
  {
   "i": 69,
   "start": 197.34,
   "end": 200.853,
   "text": "قد تتحول هذه الدقائق إلى أحب لحظات يومه"
  },
  {
   "i": 70,
   "start": 200.853,
   "end": 203.465,
   "text": "صوت أمه ويد تمسح على رأسه"
  },
  {
   "i": 71,
   "start": 203.465,
   "end": 205.498,
   "text": "وكلمات تذكره بالله"
  },
  {
   "i": 72,
   "start": 205.498,
   "end": 207.315,
   "text": "فإذا استيقظ مذعوراً"
  },
  {
   "i": 73,
   "start": 207.315,
   "end": 209.243,
   "text": "قال صلى الله عليه وسلم"
  },
  {
   "i": 74,
   "start": 209.243,
   "end": 211.048,
   "text": "الرؤية الصالحة من الله"
  },
  {
   "i": 75,
   "start": 211.048,
   "end": 212.71,
   "text": "والحلم من الشيطان"
  },
  {
   "i": 76,
   "start": 212.71,
   "end": 215.479,
   "text": "وعلمنا ما نفعل إذا رأينا ما نكره"
  },
  {
   "i": 77,
   "start": 215.479,
   "end": 222.167,
   "text": "أننفث عن يسارنا ثلاثاً ونستعيد بالله من الشيطان ثلاثاً ونتحول عن الجنب الذي"
  },
  {
   "i": 78,
   "start": 222.167,
   "end": 225.695,
   "text": "ولا نحدث بها أحدا فإنها لن تضره"
  },
  {
   "i": 79,
   "start": 225.695,
   "end": 227.981,
   "text": "فإذا فزيع صغيرك من نومه"
  },
  {
   "i": 80,
   "start": 227.981,
   "end": 230.269,
   "text": "ضمه أولا وهدئ روعة"
  },
  {
   "i": 81,
   "start": 230.269,
   "end": 232.255,
   "text": "ثم قولا معا ثلاثا"
  },
  {
   "i": 82,
   "start": 232.255,
   "end": 234.817,
   "text": "أعوذ بالله من الشيطان الرجيم"
  },
  {
   "i": 83,
   "start": 234.817,
   "end": 237.538,
   "text": "وانفثاء عن اليصار نفثاً خفيفا"
  },
  {
   "i": 84,
   "start": 237.538,
   "end": 239.657,
   "text": "ثم قلبه علاجا به الآخر"
  },
  {
   "i": 85,
   "start": 239.657,
   "end": 242.644,
   "text": "وأعد عليه آية الكرسي والمعوذات"
  },
  {
   "i": 86,
   "start": 242.644,
   "end": 243.498,
   "text": "وقل"
  },
  {
   "i": 87,
   "start": 243.498,
   "end": 245.105,
   "text": "هذا الحلم من الشيطان"
  },
  {
   "i": 88,
   "start": 245.105,
   "end": 246.974,
   "text": "والله أقوى من كل شيء"
  },
  {
   "i": 89,
   "start": 246.974,
   "end": 248.667,
   "text": "ونن يستطيع أن يؤذي"
  },
  {
   "i": 90,
   "start": 248.667,
   "end": 251.2,
   "text": "ولا تكثر من سؤاله عن طفاصيل الحلم"
  },
  {
   "i": 91,
   "start": 251.2,
   "end": 252.912,
   "text": "بلصرف قلبه إن الله"
  },
  {
   "i": 92,
   "start": 252.912,
   "end": 254.965,
   "text": "ودعاء للأمان من الفزع"
  },
  {
   "i": 93,
   "start": 254.965,
   "end": 259.893,
   "text": "رؤية أن النبي صلى الله عليه وسلم علم هذا الدعاء لمن يفزع في نومه"
  },
  {
   "i": 94,
   "start": 259.893,
   "end": 270.298,
   "text": "وكان عبد الله بن عمر يعلمه ابناء أعود بكلمات الله التامة من غضبه وعقابه وشرع عباده ومن همزات الشياطين وأن يحضرون"
  },
  {
   "i": 95,
   "start": 270.298,
   "end": 274.02,
   "text": "ومعه التعويدة التي كان يعود بها الحسن والحسين"
  },
  {
   "i": 96,
   "start": 274.02,
   "end": 278.428,
   "text": "أعيذك بكلمات الله التام من كل شيطان وهام"
  },
  {
   "i": 97,
   "start": 278.428,
   "end": 280.144,
   "text": "ومن كل عين اللم"
  },
  {
   "i": 98,
   "start": 280.144,
   "end": 282.457,
   "text": "ولكن صادقين مع نفسنا"
  },
  {
   "i": 99,
   "start": 282.457,
   "end": 285.558,
   "text": "أحيانا نحن من يكبر الخوفة في قلوب أط"
  },
  {
   "i": 100,
   "start": 285.558,
   "end": 286.421,
   "text": "أولاً"
  },
  {
   "i": 101,
   "start": 286.421,
   "end": 289.29,
   "text": "لا تخوف الأطفال بالجن والغول والبعبع"
  },
  {
   "i": 102,
   "start": 289.29,
   "end": 292.411,
   "text": "حين نقولوا للصغير لنسكتة سيأتي الجني"
  },
  {
   "i": 103,
   "start": 292.411,
   "end": 296.217,
   "text": "فإن ننزرع في قلبه الخوف ذاته الذي يقضه في الليل"
  },
  {
   "i": 104,
   "start": 296.217,
   "end": 296.54,
   "text": "اتصال"
  },
  {
   "i": 105,
   "start": 296.54,
   "end": 297.982,
   "text": "قلوا له بدلا من ذلك"
  },
  {
   "i": 106,
   "start": 297.982,
   "end": 299.36,
   "text": "الله يحفظنا"
  },
  {
   "i": 107,
   "start": 299.36,
   "end": 301.248,
   "text": "وآية الكرسي تحرسنا"
  },
  {
   "i": 108,
   "start": 301.248,
   "end": 301.678,
   "text": "كي"
  },
  {
   "i": 109,
   "start": 301.678,
   "end": 305.3,
   "text": "فانياً كان النبي صلى الله عليه وسلم رفيقا بالصحار"
  },
  {
   "i": 110,
   "start": 305.3,
   "end": 307.235,
   "text": "قال لبن عباس وهو غلام"
  },
  {
   "i": 111,
   "start": 307.235,
   "end": 308.194,
   "text": "يرلم"
  },
  {
   "i": 112,
   "start": 308.194,
   "end": 310.036,
   "text": "إني أعلمك كلمات"
  },
  {
   "i": 113,
   "start": 310.036,
   "end": 311.893,
   "text": "احفظ الله يحفظك"
  },
  {
   "i": 114,
   "start": 311.893,
   "end": 313.583,
   "text": "بالحب يخاطب الطفل"
  },
  {
   "i": 115,
   "start": 313.583,
   "end": 315.298,
   "text": "وبالله يربط قلبه"
  },
  {
   "i": 116,
   "start": 315.298,
   "end": 316.491,
   "text": "ثالثا"
  },
  {
   "i": 117,
   "start": 316.491,
   "end": 317.69,
   "text": "سكينة البيت"
  },
  {
   "i": 118,
   "start": 317.69,
   "end": 321.358,
   "text": "الطفل الذي ينام على أصوات الشجار لا ينام مطمعنا"
  },
  {
   "i": 119,
   "start": 321.358,
   "end": 324.82,
   "text": "قال تعالى ألا بذكر الله تطمئن القلوب؟"
  },
  {
   "i": 120,
   "start": 324.82,
   "end": 326.605,
   "text": "والبيت الذي يذكر فيه لا"
  },
  {
   "i": 121,
   "start": 326.605,
   "end": 328.269,
   "text": "تطمئن فيه القلوب"
  },
  {
   "i": 122,
   "start": 328.269,
   "end": 330.559,
   "text": "وإن اشتده خوف الطفل وطال"
  },
  {
   "i": 123,
   "start": 330.559,
   "end": 334.949,
   "text": "فتذكروا قوله صلى الله عليه وسلم تداوى عباد الله"
  },
  {
   "i": 124,
   "start": 334.949,
   "end": 339.994,
   "text": "فالرقية والذكر يسيران مع سائر الأسباب لا يحلان محلها"
  },
  {
   "i": 125,
   "start": 339.994,
   "end": 342.928,
   "text": "وإليكم برنامج الليل باختصار"
  },
  {
   "i": 126,
   "start": 342.928,
   "end": 344.037,
   "text": "عند الغروب"
  },
  {
   "i": 127,
   "start": 344.037,
   "end": 345.467,
   "text": "أبقوا الصغارة في ال"
  },
  {
   "i": 128,
   "start": 345.467,
   "end": 348.253,
   "text": "وأغلق الأبواب بقول بسم الله"
  },
  {
   "i": 129,
   "start": 348.253,
   "end": 350.273,
   "text": "وعلى العشاء بسم الله"
  },
  {
   "i": 130,
   "start": 350.273,
   "end": 351.38,
   "text": "وقبل النوم"
  },
  {
   "i": 131,
   "start": 351.38,
   "end": 357.619,
   "text": "وضوء ونوم على الجنب الأيمن وبجوار السرير المعوذات مع النفث والمسح ثلاثا"
  },
  {
   "i": 132,
   "start": 357.619,
   "end": 360.153,
   "text": "ثم آية الكرسي وخواتيم البقرة"
  },
  {
   "i": 133,
   "start": 360.153,
   "end": 362.87,
   "text": "ثم بسمك الله مأموت وأحيا"
  },
  {
   "i": 134,
   "start": 362.87,
   "end": 363.22,
   "text": "اتصال"
  },
  {
   "i": 135,
   "start": 363.22,
   "end": 364.76,
   "text": "وإن استيقظ فزيعا"
  },
  {
   "i": 136,
   "start": 364.76,
   "end": 366.804,
   "text": "حضن واستعادة ثلاثة"
  },
  {
   "i": 137,
   "start": 366.804,
   "end": 368.3,
   "text": "ونفذ عن اليسار"
  },
  {
   "i": 138,
   "start": 368.3,
   "end": 369.697,
   "text": "وتحويل للجنب"
  },
  {
   "i": 139,
   "start": 369.697,
   "end": 371.602,
   "text": "وإعادة لآية الكرسي"
  },
  {
   "i": 140,
   "start": 371.602,
   "end": 372.063,
   "text": "اتصال"
  },
  {
   "i": 141,
   "start": 372.063,
   "end": 374.25,
   "text": "طفلك أمانة بين يديك"
  },
  {
   "i": 142,
   "start": 374.25,
   "end": 375.026,
   "text": "وحين"
  },
  {
   "i": 143,
   "start": 375.026,
   "end": 376.666,
   "text": "تغمض عناه في الليل"
  },
  {
   "i": 144,
   "start": 376.666,
   "end": 379.876,
   "text": "لا يبقى معه إلا الذكر الذي قرأته عليه"
  },
  {
   "i": 145,
   "start": 379.876,
   "end": 383.08,
   "text": "فجلس الليل بجوار سريره ومسح على رأ"
  },
  {
   "i": 146,
   "start": 383.08,
   "end": 384.894,
   "text": "واستودعه خير حافظ"
  },
  {
   "i": 147,
   "start": 384.894,
   "end": 385.879,
   "text": "الله"
  },
  {
   "i": 148,
   "start": 385.879,
   "end": 389.484,
   "text": "شارك هذا المقطع مع كل أبن وأم أتعبهم الصهر"
  },
  {
   "i": 149,
   "start": 389.484,
   "end": 394.613,
   "text": "وكتب في التعليقات اللهم جعل ليال أطفالنا سكينة وأمانة"
  },
  {
   "i": 150,
   "start": 394.613,
   "end": 395.6,
   "text": "أمين"
  }
 ]
}