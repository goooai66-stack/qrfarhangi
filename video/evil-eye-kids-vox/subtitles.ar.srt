1
00:00:00,030 --> 00:00:02,570
حدّثتني أمٌّ عن يومٍ لن تنساه.

2
00:00:02,660 --> 00:00:09,130
كانت في زيارةٍ عند بعض الناس، وحين همّت بالقيام والانصراف مرّ بقلبها خاطرٌ سريع:

3
00:00:09,220 --> 00:00:11,540
أخشى أن يصاب طفلي بالعين.

4
00:00:11,630 --> 00:00:18,310
خرجت وركبت السيارة، ولم تمضِ إلا دقائق حتى تقيّأ الصغير مرتين متتاليتين.

5
00:00:18,400 --> 00:00:21,570
ومنذ ذلك اليوم.. تغيّر كل شيء.

6
00:00:21,660 --> 00:00:24,780
بكاءٌ لا يهدأ، ولا نومَ في نهارٍ ولا في ليل،

7
00:00:24,870 --> 00:00:26,630
خمسة أشهرٍ أو ستة،

8
00:00:26,720 --> 00:00:29,360
وكلّ ما جرّبوه لم يُجْدِ شيئًا.

9
00:00:29,450 --> 00:00:38,100
ثم بدأنا معه بالرقية الشرعية، وأوصينا أمَّه بالإكثار من الاستغفار، وأن تقرأ عليه صباحًا ومساءً سورًا وأدعية،

10
00:00:38,190 --> 00:00:40,320
والشفاء بيد الله وحده.

11
00:00:40,410 --> 00:00:43,030
وربما مررتِ أنتِ أيضًا بشيءٍ مثله؟

12
00:00:43,120 --> 00:00:52,580
في هذه الحلقة نقف مع ما جاء في الكتاب والسنة عن العين التي تصيب الصغار، وكيف نعالجها ونقي أطفالنا منها بالطريقة الشرعية،

13
00:00:52,670 --> 00:00:57,860
وفي آخرها برنامجٌ يوميٌّ متكامل يمكنك أن تبدأ به من الليلة.

14
00:00:57,950 --> 00:01:00,340
العينُ.. حقيقةٌ أم وهم؟

15
00:01:00,430 --> 00:01:03,830
قال رسول الله ﷺ: «العين حق».

16
00:01:03,920 --> 00:01:09,670
وفي رواية أخرى: «العين حق، ولو كان شيءٌ سابق القدر لسبقته العين».

17
00:01:09,760 --> 00:01:18,030
وذكر كثير من المفسرين أن قول الله تعالى: ﴿وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ﴾ نزل في شأن العين.

18
00:01:18,120 --> 00:01:22,800
لكن تذكّر دائمًا: العين لا تؤثّر إلا بإذن الله.

19
00:01:22,890 --> 00:01:28,410
فليس لنظرة أحدٍ قوةٌ مستقلة، ولسنا بلا حماية؛ فالله هو الحافظ.

20
00:01:28,500 --> 00:01:31,620
ولماذا يتأثر الأطفال أسرع من غيرهم؟

21
00:01:31,710 --> 00:01:36,210
جاءت أسماء بنت عُميس إلى النبي ﷺ فقالت:

22
00:01:36,300 --> 00:01:41,600
يا رسول الله، إن ولد جعفر تسرع إليهم العين، أفأسترقي لهم؟

23
00:01:41,690 --> 00:01:46,880
فقال: «نعم، فإنه لو كان شيءٌ سابق القدر لسبقته العين».

24
00:01:46,970 --> 00:01:54,160
ورأى ﷺ في بيت أم سلمة جاريةً في وجهها سَفْعة، أي تغيّرٌ في لونها،

25
00:01:54,250 --> 00:01:57,570
فقال: «استرقوا لها، فإن بها النظرة».

26
00:01:57,660 --> 00:02:03,750
الطفل جميل، تتعلق به الأنظار، ويُثنى عليه، وتتناقل الهواتف صورته،

27
00:02:03,840 --> 00:02:07,450
وهو لا يملك أن يذكر الله على نفسه أو يحصّنها.

28
00:02:07,540 --> 00:02:10,420
فتحصينه أمانةٌ في عنق الوالدين.

29
00:02:10,510 --> 00:02:12,370
علاماتٌ يذكرها الرقاة

30
00:02:12,460 --> 00:02:19,300
يذكر أهل الخبرة بالرقية علاماتٍ تظهر في الغالب فجأة، بعد زيارةٍ أو مديحٍ أو نظرة:

31
00:02:19,390 --> 00:02:21,930
بكاءٌ طويل بلا سببٍ ظاهر،

32
00:02:22,020 --> 00:02:23,870
وسهرٌ في الليل والنهار،

33
00:02:23,960 --> 00:02:25,650
وإعراضٌ عن الرضاعة،

34
00:02:25,740 --> 00:02:28,290
وقلقٌ حتى وهو في حضن أمه،

35
00:02:28,380 --> 00:02:30,290
وفزعٌ مفاجئ من النوم.

36
00:02:30,380 --> 00:02:33,250
غير أن هذه العلامات ليست قطعية،

37
00:02:33,340 --> 00:02:35,060
فليس كل بكاءٍ عينًا،

38
00:02:35,160 --> 00:02:39,300
فلا ننسب كل شيء إلى العين، ولا نتهم أحدًا بغير بيّنة.

39
00:02:39,390 --> 00:02:49,130
والجميل في الرقية الشرعية أنها إن كانت عينًا فهي بإذن الله شفاء، وإن لم تكن فهي ذكرٌ ودعاءٌ وبركة، لا ضرر فيها.

40
00:02:49,220 --> 00:02:52,130
والآن، العلاج خطوةً خطوة.

41
00:02:52,220 --> 00:02:55,060
الخطوة الأولى: اليقين والتوكل.

42
00:02:55,150 --> 00:03:00,570
قال تعالى: ﴿وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِّلْمُؤْمِنِينَ﴾

43
00:03:00,660 --> 00:03:06,720
اقرأ وأنتِ موقنةٌ أن الشافي هو الله وحده، لا أنتِ ولا كلماتك.

44
00:03:07,570 --> 00:03:10,720
الخطوة الثانية: القراءة على الطفل.

45
00:03:10,810 --> 00:03:18,120
أخبرت عائشة رضي الله عنها أن النبي ﷺ كان إذا اشتكى قرأ على نفسه بالمعوذات ونفث.

46
00:03:18,210 --> 00:03:21,610
فاجلسي قرب طفلك متوضئة،

47
00:03:21,700 --> 00:03:24,890
وضعي يدك اليمنى برفق على رأسه أو صدره،

48
00:03:24,980 --> 00:03:28,840
واقرئي وانفثي عليه نفثًا خفيفًا بعد كل سورة.

49
00:03:28,930 --> 00:03:30,540
وفي كل صباحٍ ومساء:

50
00:03:30,630 --> 00:03:35,590
الفاتحة سبع مرات، وآية الكرسي، وخواتيم سورة البقرة «آمَنَ الرَّسُولُ»،

51
00:03:35,680 --> 00:03:40,150
والإخلاص والفلق والناس، ثلاثًا ثلاثًا.

52
00:03:40,650 --> 00:03:48,840
أما الفاتحة فقد رقى بها صحابيٌّ مريضًا فشُفي، فقال له النبي ﷺ: «وما يدريك أنها رقية؟»

53
00:03:48,940 --> 00:03:53,470
وعدد السبع من تجارب الرقاة، والمعوَّل عليه حضور القلب.

54
00:03:53,560 --> 00:04:00,720
وآية الكرسي: «من قرأها لم يزل عليه من الله حافظ، ولا يقربه شيطانٌ حتى يصبح».

55
00:04:00,810 --> 00:04:04,640
وخواتيم البقرة: «من قرأهما في ليلةٍ كفتاه».

56
00:04:04,730 --> 00:04:13,030
والمعوذات قال فيها ﷺ: «تقرؤها حين تمسي وحين تصبح ثلاثًا، تكفيك من كل شيء».

57
00:04:13,600 --> 00:04:17,220
الخطوة الثالثة: أدعية النبي ﷺ.

58
00:04:17,310 --> 00:04:26,680
كان يعوّذ الحسن والحسين بقوله: «أُعِيذُكُمَا بِكَلِمَاتِ اللَّهِ التَّامَّةِ مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ».

59
00:04:26,770 --> 00:04:34,060
فقولي لطفلك: أُعِيذُكَ بِكَلِمَاتِ اللَّهِ التَّامَّةِ مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ، وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ.

60
00:04:34,140 --> 00:04:43,980
ورقى جبريل عليه السلام النبيَّ ﷺ فقال: «بِاسْمِ اللَّهِ أَرْقِيكَ، مِنْ كُلِّ شَيْءٍ يُؤْذِيكَ، مِنْ شَرِّ كُلِّ نَفْسٍ أَوْ عَيْنِ حَاسِدٍ،

61
00:04:44,070 --> 00:04:47,230
اللَّهُ يَشْفِيكَ، بِاسْمِ اللَّهِ أَرْقِيكَ».

62
00:04:47,320 --> 00:04:48,040
وادعي:

63
00:04:48,130 --> 00:04:56,860
«اللَّهُمَّ رَبَّ النَّاسِ، أَذْهِبِ الْبَأْسَ، اشْفِهِ وَأَنْتَ الشَّافِي، لَا شِفَاءَ إِلَّا شِفَاؤُكَ، شِفَاءً لَا يُغَادِرُ سَقَمًا».

64
00:04:56,950 --> 00:05:02,210
وقولي سبع مرات: «أَسْأَلُ اللَّهَ الْعَظِيمَ رَبَّ الْعَرْشِ الْعَظِيمِ أَنْ يَشْفِيَكَ».

65
00:05:02,300 --> 00:05:05,020
الخطوة الرابعة: ماء الرقية.

66
00:05:05,110 --> 00:05:09,630
اقرئي هذه السور والأدعية على إناءِ ماء، وانفثي فيه.

67
00:05:09,720 --> 00:05:12,640
فإن كان الطفل كبيرًا شرب منه،

68
00:05:12,730 --> 00:05:16,920
وإن كان رضيعًا فامسحي بالماء وجهه ويديه وقدميه،

69
00:05:17,010 --> 00:05:19,730
وقد أجاز ذلك كثيرٌ من أهل العلم.

70
00:05:19,820 --> 00:05:22,960
الخطوة الخامسة: استغفار الوالدين.

71
00:05:23,050 --> 00:05:29,140
استغفري ربكِ، فقد يكون هناك سببٌ لا نعلمه، فيكون الاستغفار سببًا في الشفاء.

72
00:05:29,230 --> 00:05:41,440
قال تعالى على لسان نوح عليه السلام: ﴿فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا * يُرْسِلِ السَّمَاءَ عَلَيْكُم مِّدْرَارًا * وَيُمْدِدْكُم بِأَمْوَالٍ وَبَنِينَ﴾

73
00:05:41,530 --> 00:05:44,980
تأمّلي كيف ربط الله الاستغفار بالبركة في الأبناء.

74
00:05:45,070 --> 00:05:52,390
فأكثري منه يا أماه، وأنتِ في عمل البيت وفي الطريق وبجوار مهد صغيرك، وادعي له بقلبٍ منكسر.

75
00:05:52,480 --> 00:05:55,520
الخطوة السادسة: اغتسال العائن

76
00:05:55,610 --> 00:06:04,170
أصيب سهل بن حنيف بالعين فصُرع، فقال النبي ﷺ للذي أصابه: «عَلَامَ يَقْتُلُ أَحَدُكُمْ أَخَاهُ؟ أَلَا بَرَّكْتَ؟»

77
00:06:04,260 --> 00:06:07,720
وأمره أن يغتسل له، فقام سهلٌ معافى.

78
00:06:07,810 --> 00:06:11,610
وقال ﷺ: «وإذا استُغسلتم فاغسلوا».

79
00:06:11,700 --> 00:06:14,650
لكن هذا عند اليقين لا بالظن والتخمين،

80
00:06:14,740 --> 00:06:17,310
ويُطلب بلطفٍ ومن غير خصام.

81
00:06:17,400 --> 00:06:20,540
الخطوة السابعة: الصبر والمداومة.

82
00:06:20,630 --> 00:06:25,920
الرقية ليست عمل يومٍ واحد، داومي عليها أيامًا وأسابيع ولا تيأسي،

83
00:06:26,010 --> 00:06:28,930
فالشفاء يأتي في الوقت الذي يريده الله.

84
00:06:29,020 --> 00:06:30,520
واحذري الدجالين.

85
00:06:30,610 --> 00:06:38,370
قال ﷺ: «لا بأس بالرُّقى ما لم يكن فيه شرك»، وقال: «من علّق تميمةً فقد أشرك».

86
00:06:38,460 --> 00:06:49,410
فإن كتب أحدٌ لطفلك طلسمًا، أو أعطاك ورقةً بكلامٍ غير مفهوم، أو سألك عن اسم أمّك، أو طلب ذبح حيوان، فاعلمي أن هذا ليس طريق الشرع.

87
00:06:49,500 --> 00:06:57,230
الرقية الشرعية قرآنٌ وأدعيةٌ نبوية، بلسانٍ واضحٍ تفهمينه، وأنتِ وأبوه أولى الناس بأن تقرؤوها عليه.

88
00:06:57,320 --> 00:07:01,350
وتذكّري قوله ﷺ: «تداووا عباد الله».

89
00:07:01,440 --> 00:07:04,780
فالرقية لا تلغي الأخذ بالأسباب، بل تُسانِدها،

90
00:07:04,870 --> 00:07:07,450
والوقاية خيرٌ من انتظار البلاء.

91
00:07:07,540 --> 00:07:13,820
إذا أعجبك شيءٌ من طفلٍ فقولي: ما شاء الله لا قوة إلا بالله، أو: بارك الله فيه.

92
00:07:13,910 --> 00:07:19,830
قال تعالى: ﴿وَلَوْلَا إِذْ دَخَلْتَ جَنَّتَكَ قُلْتَ مَا شَاءَ اللَّهُ لَا قُوَّةَ إِلَّا بِاللَّهِ﴾

93
00:07:19,920 --> 00:07:25,800
وقال ﷺ: «إذا رأى أحدكم من أخيه ما يعجبه فليدعُ له بالبركة».

94
00:07:25,890 --> 00:07:33,190
وقلّلي من نشر صور طفلك ولحظاته الخاصة على مواقع التواصل، فليست كل نظرةٍ مصحوبةً بالدعاء.

95
00:07:33,280 --> 00:07:38,880
وحصّنيه صباحًا ومساءً بتعويذة النبي ﷺ، وقولي ثلاثًا:

96
00:07:38,970 --> 00:07:44,070
«بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ».

97
00:07:44,160 --> 00:07:51,570
وأحيي بيتك بالقرآن، فقد أخبر ﷺ أن الشيطان ينفر من البيت الذي تُقرأ فيه سورة البقرة.

98
00:07:51,660 --> 00:07:55,970
وخلاصة القول: العين حق، لكن الله أكبر من كل نظرة،

99
00:07:56,060 --> 00:07:59,200
والقرآن شفاء، لكن الشافي هو الله،

100
00:07:59,290 --> 00:08:03,320
والوالدان هما أول من يرقي الطفل، وأولى الناس بذلك.

101
00:08:03,410 --> 00:08:12,870
إن كنتَ تعرف أمًّا تسهر الليالي بجوار مهد صغيرها فأرسل لها هذا المقطع، واكتب في التعليقات دعاءً لكل طفلٍ مريض.

102
00:08:12,960 --> 00:08:17,080
«اللَّهُمَّ اشْفِ أَطْفَالَنَا وَأَطْفَالَ الْمُسْلِمِينَ، وَأَلْبِسْهُمْ ثَوْبَ الْعَافِيَةِ».

103
00:08:17,170 --> 00:08:17,980
آمين.

