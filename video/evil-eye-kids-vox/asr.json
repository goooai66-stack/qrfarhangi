 "segs": [
  {
   "i": 0,
   "start": 0.0,
   "end": 2.626,
   "text": "حدثتني أم عن يوم لنتنسى"
  },
  {
   "i": 1,
   "start": 2.626,
   "end": 9.186,
   "text": "كانت في زيارة عند بعض الناس وحين همد بالقيام والانصراف مر بقلبها خاطر سريع"
  },
  {
   "i": 2,
   "start": 9.186,
   "end": 11.596,
   "text": "أخشاء أن يصاب طفلي بالعين"
  },
  {
   "i": 3,
   "start": 11.596,
   "end": 18.371,
   "text": "خرجت وركبة السيارة ولم تمضي إلا دقائق حتى تقيئ الصغير مرتين متتاليتين"
  },
  {
   "i": 4,
   "start": 18.371,
   "end": 19.716,
   "text": "وموضوع ذلك اليوم"
  },
  {
   "i": 5,
   "start": 19.716,
   "end": 21.627,
   "text": "تغير كل شيء"
  },
  {
   "i": 6,
   "start": 21.627,
   "end": 24.84,
   "text": "بكاء اللي يهدأ لنوم في نهار ولا في ليل"
  },
  {
   "i": 7,
   "start": 24.84,
   "end": 26.691,
   "text": "خمسة أشهر أو ستة"
  },
  {
   "i": 8,
   "start": 26.691,
   "end": 29.417,
   "text": "وكل ما جربوه لم يوجد شيء"
  },
  {
   "i": 9,
   "start": 29.417,
   "end": 38.163,
   "text": "ثم بدأنا معه بالرقية الشرعية وأصينا أمه بالإكثار من الاستخفار وأن تقرأ عليه صباحا ومساءا سورا و"
  },
  {
   "i": 10,
   "start": 38.163,
   "end": 40.376,
   "text": "والشفاء بيد الله وحده"
  },
  {
   "i": 11,
   "start": 40.376,
   "end": 43.089,
   "text": "ربما مررتي أنت عيضاً بشيء"
  },
  {
   "i": 12,
   "start": 43.089,
   "end": 52.636,
   "text": "في هذه الحلقة نقف معما جاء في الكتاب والسنة عن العين التي تصيب الصغر وكيف نعليجها ونقئ الطفالنا منها بالطريقة الشرعية"
  },
  {
   "i": 13,
   "start": 52.636,
   "end": 57.922,
   "text": "وفي أخرها برنامج يومي متكامل يمكنك أن تبدأ به من الليلة"
  },
  {
   "i": 14,
   "start": 57.922,
   "end": 60.396,
   "text": "العين حقيقة لوهم"
  },
  {
   "i": 15,
   "start": 60.396,
   "end": 63.891,
   "text": "قد رسول الله صلى الله عليه وسلم العين حق"
  },
  {
   "i": 16,
   "start": 63.891,
   "end": 69.73,
   "text": "وفي رواية أخرى العين حق ولو كان شيء سابق القدر سابقته العين"
  },
  {
   "i": 17,
   "start": 69.73,
   "end": 76.542,
   "text": "وذكر كثير من المفسرين أن قول الله تعالى وإن يكاد الذين كفروا لا يزلقونك بأبصار"
  },
  {
   "i": 18,
   "start": 76.542,
   "end": 78.089,
   "text": "نزل في شأن العين"
  },
  {
   "i": 19,
   "start": 78.089,
   "end": 79.76,
   "text": "لكن تذكر دائماً"
  },
  {
   "i": 20,
   "start": 79.76,
   "end": 82.858,
   "text": "العين لا تؤثر إلا بإذن الله"
  },
  {
   "i": 21,
   "start": 82.858,
   "end": 86.831,
   "text": "فليس لنظرة أحد قوة مستقلة ولسنا بلا حما"
  },
  {
   "i": 22,
   "start": 86.831,
   "end": 88.472,
   "text": "فالله هو الحافظ"
  },
  {
   "i": 23,
   "start": 88.472,
   "end": 91.684,
   "text": "ولماذا يتأثر الأطفال أسرع من غيرهم؟"
  },
  {
   "i": 24,
   "start": 91.684,
   "end": 95.437,
   "text": "جاءت أسماء بنت عميس إلى النبي صلى الله عليه وسلم"
  },
  {
   "i": 25,
   "start": 95.437,
   "end": 96.27,
   "text": "فقالت"
  },
  {
   "i": 26,
   "start": 96.27,
   "end": 98.644,
   "text": "يا رسول الله إن ولد جعفر"
  },
  {
   "i": 27,
   "start": 98.644,
   "end": 100.215,
   "text": "تسرعوا إليهم العين"
  },
  {
   "i": 28,
   "start": 100.215,
   "end": 101.662,
   "text": "أفأستقيلهم؟"
  },
  {
   "i": 29,
   "start": 101.662,
   "end": 103.159,
   "text": "فقال نعم"
  },
  {
   "i": 30,
   "start": 103.159,
   "end": 106.941,
   "text": "فإنه لو كان شيء سابق القدرة لسبقته العين"
  },
  {
   "i": 31,
   "start": 106.941,
   "end": 110.323,
   "text": "ورأى صلى الله عليه وسلم في بيت أم سلمة"
  },
  {
   "i": 32,
   "start": 110.323,
   "end": 112.38,
   "text": "جارية في وجهها سفعة"
  },
  {
   "i": 33,
   "start": 112.38,
   "end": 114.225,
   "text": "أي تغيير في لونها"
  },
  {
   "i": 34,
   "start": 114.225,
   "end": 115.057,
   "text": "فقال"
  },
  {
   "i": 35,
   "start": 115.057,
   "end": 116.251,
   "text": "استرقولها"
  },
  {
   "i": 36,
   "start": 116.251,
   "end": 117.63,
   "text": "فإن بها النظرة"
  },
  {
   "i": 37,
   "start": 117.63,
   "end": 123.811,
   "text": "الطفل جميل تتعلق به الأنظار ويثنى عليه وتتناقل الهواتف صورة"
  },
  {
   "i": 38,
   "start": 123.811,
   "end": 127.507,
   "text": "وهو لا يملك أن يذكر الله على نفسه أو يحصنها"
  },
  {
   "i": 39,
   "start": 127.507,
   "end": 130.477,
   "text": "فطحصينه أمانة فيعونق والدي"
  },
  {
   "i": 40,
   "start": 130.477,
   "end": 132.431,
   "text": "علمات يذكرها الرقا"
  },
  {
   "i": 41,
   "start": 132.431,
   "end": 136.825,
   "text": "يذكر أهل الخبرة بالرقية علامات تظهر في الغالب فجأ"
  },
  {
   "i": 42,
   "start": 136.825,
   "end": 139.364,
   "text": "بعد زيارة أو مديح أو نظرة"
  },
  {
   "i": 43,
   "start": 139.364,
   "end": 141.99,
   "text": "بكاء طويل بلاسبب ظاهر"
  },
  {
   "i": 44,
   "start": 141.99,
   "end": 143.932,
   "text": "وسهر في الليل والنهار"
  },
  {
   "i": 45,
   "start": 143.932,
   "end": 145.714,
   "text": "وإعراض عن الرضاعة"
  },
  {
   "i": 46,
   "start": 145.714,
   "end": 148.346,
   "text": "وقال قن حتى وهو في حضني أمه"
  },
  {
   "i": 47,
   "start": 148.346,
   "end": 150.354,
   "text": "وفزع مفاجئ من النوم"
  },
  {
   "i": 48,
   "start": 150.354,
   "end": 153.31,
   "text": "غير أن هذه العلمات ليست قطية"
  },
  {
   "i": 49,
   "start": 153.31,
   "end": 155.125,
   "text": "فليس كل بكاء عيناً"
  },
  {
   "i": 50,
   "start": 155.125,
   "end": 159.356,
   "text": "فلا ننسب كل شيء إلى العين ولا نتهم أحداً بغير بينه"
  },
  {
   "i": 51,
   "start": 159.356,
   "end": 167.924,
   "text": "والجميل في الروقية الشرعية أنها إن كانت عين فهي بإذن الله شفاء وإن لم تكن فهي ذكر ودعاء وبركة"
  },
  {
   "i": 52,
   "start": 167.924,
   "end": 169.186,
   "text": "لا ضرر فيها"
  },
  {
   "i": 53,
   "start": 169.186,
   "end": 170.237,
   "text": "والآن"
  },
  {
   "i": 54,
   "start": 170.237,
   "end": 172.186,
   "text": "العلاج خطوة خطوة"
  },
  {
   "i": 55,
   "start": 172.186,
   "end": 173.522,
   "text": "الخطوة الأولى"
  },
  {
   "i": 56,
   "start": 173.522,
   "end": 175.118,
   "text": "اليقين وتوكل"
  },
  {
   "i": 57,
   "start": 175.118,
   "end": 180.631,
   "text": "قال تعالى وننزل من القرآن ما هو شفاء ورحمة للمؤمنين"
  },
  {
   "i": 58,
   "start": 180.631,
   "end": 186.778,
   "text": "إقرأ وانت موقنة أن الشافي هو الله وحده لا أنت ولا كلماتك"
  },
  {
   "i": 59,
   "start": 186.778,
   "end": 187.538,
   "text": "اتصال"
  },
  {
   "i": 60,
   "start": 187.538,
   "end": 188.993,
   "text": "الخطوة الثانية"
  },
  {
   "i": 61,
   "start": 188.993,
   "end": 190.777,
   "text": "القراءة على الطفل"
  },
  {
   "i": 62,
   "start": 190.777,
   "end": 198.175,
   "text": "أخبرت عائشة رضي الله عنها أن النبي صلى الله عليه وسلم كان إذا اشتكى قرأ على نفسه بالمعوذات ون"
  },
  {
   "i": 63,
   "start": 198.175,
   "end": 201.669,
   "text": "فجليسي قرب طفلك متوضئة انت يسر"
  },
  {
   "i": 64,
   "start": 201.669,
   "end": 204.951,
   "text": "وضايدك اليومنا برفق على رأسه أو صدره"
  },
  {
   "i": 65,
   "start": 204.951,
   "end": 208.895,
   "text": "وقرأي ونفوثي عليه نفثاً خفيفاً بعد كل سور"
  },
  {
   "i": 66,
   "start": 208.895,
   "end": 210.598,
   "text": "وفي كل صباح ومساء"
  },
  {
   "i": 67,
   "start": 210.598,
   "end": 212.439,
   "text": "الفاتحة 7 مرات"
  },
  {
   "i": 68,
   "start": 212.439,
   "end": 213.776,
   "text": "وآية الكرسي"
  },
  {
   "i": 69,
   "start": 213.776,
   "end": 215.651,
   "text": "وخوات مسورة البقرة"
  },
  {
   "i": 70,
   "start": 215.651,
   "end": 216.808,
   "text": "أمن الرسول"
  },
  {
   "i": 71,
   "start": 216.808,
   "end": 218.966,
   "text": "والإخلاصة والفلق والناس"
  },
  {
   "i": 72,
   "start": 218.966,
   "end": 220.206,
   "text": "ثلاثا ثلاث"
  },
  {
   "i": 73,
   "start": 220.206,
   "end": 220.615,
   "text": "تفتح"
  },
  {
   "i": 74,
   "start": 220.615,
   "end": 221.665,
   "text": "أما الفاتحة"
  },
  {
   "i": 75,
   "start": 221.665,
   "end": 224.412,
   "text": "فقد رقبها صحابي مريضا فشوفي"
  },
  {
   "i": 76,
   "start": 224.412,
   "end": 226.964,
   "text": "فقال له النبي صلى الله عليه وسلم"
  },
  {
   "i": 77,
   "start": 226.964,
   "end": 228.905,
   "text": "وما يدريك أنها رقيا"
  },
  {
   "i": 78,
   "start": 228.905,
   "end": 231.143,
   "text": "وعدد السبع من تجارب الرقاة"
  },
  {
   "i": 79,
   "start": 231.143,
   "end": 233.534,
   "text": "والمعاول عليه حضور القلب"
  },
  {
   "i": 80,
   "start": 233.534,
   "end": 235.194,
   "text": "وآية الكرسي"
  },
  {
   "i": 81,
   "start": 235.194,
   "end": 238.115,
   "text": "من قرأها لم يزل عليه من الله حافظ"
  },
  {
   "i": 82,
   "start": 238.115,
   "end": 240.782,
   "text": "ولا يقربه شيطان حتى يصبح"
  },
  {
   "i": 83,
   "start": 240.782,
   "end": 242.391,
   "text": "وخواتيم البقرة"
  },
  {
   "i": 84,
   "start": 242.391,
   "end": 244.701,
   "text": "من قرأهما في ليلة كفتا"
  },
  {
   "i": 85,
   "start": 244.701,
   "end": 248.122,
   "text": "والمعوذات قال فيها صلى الله عليه وسلم"
  },
  {
   "i": 86,
   "start": 248.122,
   "end": 251.342,
   "text": "تقرأها حين تمسي وحين تصبح ثلاثة"
  },
  {
   "i": 87,
   "start": 251.342,
   "end": 253.091,
   "text": "تكفيك من كل شيء"
  },
  {
   "i": 88,
   "start": 253.091,
   "end": 253.575,
   "text": "(تصميم"
  },
  {
   "i": 89,
   "start": 253.575,
   "end": 257.279,
   "text": "الخطوة الثالثة أدعية النبي صلى الله عليه وسلم"
  },
  {
   "i": 90,
   "start": 257.279,
   "end": 260.337,
   "text": "كان يعوذ الحسن والحسين بقوله"
  },
  {
   "i": 91,
   "start": 260.337,
   "end": 266.744,
   "text": "أعيذكم بكلمات الله التامة من كل شيطان وهمة ومن كل عين لا ما"
  },
  {
   "i": 92,
   "start": 266.744,
   "end": 274.115,
   "text": "فقول لطفلك أعيدك بكلمات الله التامة من كل شيطان وهامة ومن كل عين لامة"
  },
  {
   "i": 93,
   "start": 274.115,
   "end": 281.434,
   "text": "ورقا جبريل عليه السلام أن نبي صلى الله عليه وسلم فقال بسم الله أرقيك من كل شيء يؤذيك"
  },
  {
   "i": 94,
   "start": 281.434,
   "end": 284.043,
   "text": "من شر كل نفس أو عين حاسد"
  },
  {
   "i": 95,
   "start": 284.043,
   "end": 285.53,
   "text": "الله يشفيك"
  },
  {
   "i": 96,
   "start": 285.53,
   "end": 287.294,
   "text": "بسم الله أرقيك"
  },
  {
   "i": 97,
   "start": 287.294,
   "end": 288.096,
   "text": "ودي"
  },
  {
   "i": 98,
   "start": 288.096,
   "end": 296.924,
   "text": "اللهم رب الناس اذهب البأس اشفه وانت الشافي لا شفاء إلا شفاءك شفاء لا يغادر سقمة"
  },
  {
   "i": 99,
   "start": 296.924,
   "end": 302.267,
   "text": "وقولي سبع مرات أسأل الله العظيم رب العرش العظيم أن يشفيك"
  },
  {
   "i": 100,
   "start": 302.267,
   "end": 303.695,
   "text": "الخطوة الرابعة"
  },
  {
   "i": 101,
   "start": 303.695,
   "end": 305.082,
   "text": "ماء الرقية"
  },
  {
   "i": 102,
   "start": 305.082,
   "end": 308.519,
   "text": "إقرأ هذه السور والأدعي على إينا إن فيهما"
  },
  {
   "i": 103,
   "start": 308.519,
   "end": 309.688,
   "text": "وانفوذي في"
  },
  {
   "i": 104,
   "start": 309.688,
   "end": 312.697,
   "text": "فإن كان الطفل كبيرا شريب منهور شفات"
  },
  {
   "i": 105,
   "start": 312.697,
   "end": 316.979,
   "text": "وإن كان رضيعا فمسحي بالماء وجهه ويديه وقدميه"
  },
  {
   "i": 106,
   "start": 316.979,
   "end": 319.79,
   "text": "وقد أجاز ذلك كثير من أهل العلم"
  },
  {
   "i": 107,
   "start": 319.79,
   "end": 321.299,
   "text": "الخطوة الخامسة"
  },
  {
   "i": 108,
   "start": 321.299,
   "end": 323.024,
   "text": "استغفار والدين"
  },
  {
   "i": 109,
   "start": 323.024,
   "end": 324.397,
   "text": "استغفري ربكي"
  },
  {
   "i": 110,
   "start": 324.397,
   "end": 326.778,
   "text": "فقد يكون هناك السبب لا نعلمه"
  },
  {
   "i": 111,
   "start": 326.778,
   "end": 329.196,
   "text": "فيكونوا لاستغفار وبينية شفاء."
  },
  {
   "i": 112,
   "start": 329.196,
   "end": 331.848,
   "text": "قال تعالى على اللسان نوح عليه السلام"
  },
  {
   "i": 113,
   "start": 331.848,
   "end": 333.771,
   "text": "فقلت استغفروا ربكم"
  },
  {
   "i": 114,
   "start": 333.771,
   "end": 335.462,
   "text": "إنه كان غفارة"
  },
  {
   "i": 115,
   "start": 335.462,
   "end": 339.695,
   "text": "يرسل السماء عليكم مدرارة ويمددكم"
  },
  {
   "i": 116,
   "start": 339.695,
   "end": 341.503,
   "text": "بأموال وبنين"
  },
  {
   "i": 117,
   "start": 341.503,
   "end": 345.036,
   "text": "تأمل كيف ربط الله لاستخفار بالبركة في الأبنى"
  },
  {
   "i": 118,
   "start": 345.036,
   "end": 352.446,
   "text": "فأكثر منه يا أماه وأنت في عمل البيت وفي الطريق وبجوار مهدي صغيرك ودع له بقلب منكسر"
  },
  {
   "i": 119,
   "start": 352.446,
   "end": 354.067,
   "text": "أنخطوة سادسة"
  },
  {
   "i": 120,
   "start": 354.067,
   "end": 355.576,
   "text": "نعري فلعان"
  },
  {
   "i": 121,
   "start": 355.576,
   "end": 361.173,
   "text": "أصيب سهل بن حنيف بالعين فالصرعة فقال النبي صلى الله عليه وسلم للذي أصاب"
  },
  {
   "i": 122,
   "start": 361.173,
   "end": 364.233,
   "text": "على ما يقتل أحدكم أخاة ألا بركت؟"
  },
  {
   "i": 123,
   "start": 364.233,
   "end": 366.031,
   "text": "وأمره أن يختسل له"
  },
  {
   "i": 124,
   "start": 366.031,
   "end": 367.779,
   "text": "فقام سهل معافة"
  },
  {
   "i": 125,
   "start": 367.779,
   "end": 371.67,
   "text": "وقال صلى الله عليه وسلم وإذا استغسلتم فرسلوا"
  },
  {
   "i": 126,
   "start": 371.67,
   "end": 374.707,
   "text": "لكن هذا عند اليقين لا بالظن و التخمين"
  },
  {
   "i": 127,
   "start": 374.707,
   "end": 377.371,
   "text": "ويطلبوا بلوتفن ومن غيري خصام"
  },
  {
   "i": 128,
   "start": 377.371,
   "end": 378.889,
   "text": "الخطوة السابعة"
  },
  {
   "i": 129,
   "start": 378.889,
   "end": 380.603,
   "text": "الصبر والمداومة"
  },
  {
   "i": 130,
   "start": 380.603,
   "end": 382.834,
   "text": "الرقية ليست عمل يوم واحد"
  },
  {
   "i": 131,
   "start": 382.834,
   "end": 385.98,
   "text": "دوم عليها أياماً وأسبيع ولا تيسي"
  },
  {
   "i": 132,
   "start": 385.98,
   "end": 388.99,
   "text": "فالشفاء يأتي في الوقت الذي يريده الله"
  },
  {
   "i": 133,
   "start": 388.99,
   "end": 390.577,
   "text": "وحضر الدجالين"
  },
  {
   "i": 134,
   "start": 390.577,
   "end": 398.43,
   "text": "قال صلى الله عليه وسلم لا بأس بالرقى ما لم يكن فيه شرك وقال من علق تميمة فقد أشرك"
  },
  {
   "i": 135,
   "start": 398.43,
   "end": 406.798,
   "text": "فإن كتب أحد لطفلك طلصما أو عطاك ورقة بكلام غير مفهوم أو سألك عن اسم أمك أو طلب ذبح حيوان"
  },
  {
   "i": 136,
   "start": 406.798,
   "end": 409.467,
   "text": "فعلم أن هذا ليس طريق الشرع"
  },
  {
   "i": 137,
   "start": 409.467,
   "end": 414.318,
   "text": "الرقية الشرعية قرآن وأدعية النبوية باللسان واضح تفهمينة"
  },
  {
   "i": 138,
   "start": 414.318,
   "end": 417.293,
   "text": "وأنت وأبوه أو للناس بأن تقرأها علي"
  },
  {
   "i": 139,
   "start": 417.293,
   "end": 419.952,
   "text": "وتذكر قوله صلى الله عليه وسلم"
  },
  {
   "i": 140,
   "start": 419.952,
   "end": 421.41,
   "text": "تداوى وعباد الله"
  },
  {
   "i": 141,
   "start": 421.41,
   "end": 424.837,
   "text": "فالرقية لا تلغي الأغذة من الأسباب بل تس"
  },
  {
   "i": 142,
   "start": 424.837,
   "end": 427.51,
   "text": "الوقايا خير من انتظار البلاق"
  },
  {
   "i": 143,
   "start": 427.51,
   "end": 432.216,
   "text": "إذا عجبك شيء من طفل فقول ما شاء الله لا قوة إلا بالله"
  },
  {
   "i": 144,
   "start": 432.216,
   "end": 433.883,
   "text": "أو بارك الله فيه"
  },
  {
   "i": 145,
   "start": 433.883,
   "end": 434.981,
   "text": "قال تعالى"
  },
  {
   "i": 146,
   "start": 434.981,
   "end": 439.887,
   "text": "ولولا إذا خلت جنتك قلت ما شا الله لا قوة إلا بالله"
  },
  {
   "i": 147,
   "start": 439.887,
   "end": 441.957,
   "text": "وقال صلى الله عليه وسلم"
  },
  {
   "i": 148,
   "start": 441.957,
   "end": 445.86,
   "text": "إذا رأى أحدكم من أخيه ما يعجبه فليدعوا له بال"
  },
  {
   "i": 149,
   "start": 445.86,
   "end": 453.249,
   "text": "وقل لي من نشر صور طفلك و لحظاته الخاصة على مواقع التواصل فليست كل نظرة مصحوبة بالدعاء"
  },
  {
   "i": 150,
   "start": 453.249,
   "end": 457.427,
   "text": "وحصنه صباحاً ومساءاً بتعويدة النبي صلى الله عليه"
  },
  {
   "i": 151,
   "start": 457.427,
   "end": 458.941,
   "text": "وقولي أنت ثلاثا"
  },
  {
   "i": 152,
   "start": 458.941,
   "end": 462.731,
   "text": "بسم الله الذي لا يضر معسمه شيء في الأرض ولا في السماء"
  },
  {
   "i": 153,
   "start": 462.731,
   "end": 464.126,
   "text": "وهو السميع العليم"
  },
  {
   "i": 154,
   "start": 464.126,
   "end": 465.904,
   "text": "وأحي بيتك بالقرآن"
  },
  {
   "i": 155,
   "start": 465.904,
   "end": 471.627,
   "text": "فقد أخبر صلى الله عليه وسلم أن الشيطان ينفر من البيت الذي تقرأ فيه صورة البق"
  },
  {
   "i": 156,
   "start": 471.627,
   "end": 472.9,
   "text": "وخلاصة القول"
  },
  {
   "i": 157,
   "start": 472.9,
   "end": 476.033,
   "text": "العين حق لكن الله أكبر من كل نظرة"
  },
  {
   "i": 158,
   "start": 476.033,
   "end": 479.262,
   "text": "والقرآن شفاء لكن الشافي هو الله"
  },
  {
   "i": 159,
   "start": 479.262,
   "end": 483.377,
   "text": "والوالدان هما أول من يرقى الطفل وأول الناس بذلك"
  },
  {
   "i": 160,
   "start": 483.377,
   "end": 489.346,
   "text": "إن كنت تعرفنا أم تسهر الليال بجوار ماهد صغيرها فأرسل لها هذا المقطع"
  },
  {
   "i": 161,
   "start": 489.346,
   "end": 492.928,
   "text": "وكتب في التعليقات دعاء لكل طفل مريض"
  },
  {
   "i": 162,
   "start": 492.928,
   "end": 497.144,
   "text": "اللهم مشفئ اطفالنا و اطفال المسلمين و قلبسهم ثوب الع"
  },
  {
   "i": 163,
   "start": 497.144,
   "end": 498.04,
   "text": "أمين"
  }
 ]
}